@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State
@implements IDisposable

<div class="nb-display-pane">
    <div class="nb-display-pane__left">
        <div class="nb-text-label nb-display-pane__label">TARGET MONITOR</div>
        <div class="nb-display-pane__select">
            @if (State.MonitorOptions.Count == 0)
            {
                <select class="nb-display-pane__select-native" disabled>
                    <option>No monitor</option>
                </select>
            }
            else
            {
                <select class="nb-display-pane__select-native" @onchange="OnMonitorChanged">
                    @foreach (var m in State.MonitorOptions)
                    {
                        <option value="@m" selected="@(m == TargetMonitorName)">@m</option>
                    }
                </select>
            }
            <span class="nb-display-pane__select-caret">▾</span>
        </div>

        <div class="nb-display-pane__row">
            <div class="nb-display-pane__field">
                <div class="nb-text-label nb-display-pane__field-label">WIDTH</div>
                <SteppedNumberField Value="@State.Width" OnStep="@(delta => AdjustWidth(delta))" />
            </div>
            <div class="nb-display-pane__field">
                <div class="nb-text-label nb-display-pane__field-label">HEIGHT</div>
                <SteppedNumberField Value="@State.Height" OnStep="@(delta => AdjustHeight(delta))" />
            </div>
        </div>

        <div class="nb-display-pane__row nb-display-pane__row--offsets">
            <div class="nb-display-pane__field">
                <div class="nb-text-label nb-display-pane__field-label">OFFSET X</div>
                <SteppedNumberField Value="@State.OffsetX" BorderSubtle="true" OnStep="@(delta => AdjustOffsetX(delta))" />
            </div>
            <div class="nb-display-pane__field">
                <div class="nb-text-label nb-display-pane__field-label">OFFSET Y</div>
                <SteppedNumberField Value="@State.OffsetY" BorderSubtle="true" OnStep="@(delta => AdjustOffsetY(delta))" />
            </div>
        </div>

        <div class="nb-text-subline nb-display-pane__hint">Arrows step by 1 px · hold Shift for 10 · Ctrl for 100</div>

        <label class="nb-display-pane__check" @onclick="OnToggleConstrainMouse">
            <span class="nb-display-pane__check-box @(State.ConstrainMouse ? "nb-display-pane__check-box--checked" : "")">@(State.ConstrainMouse ? "✓" : "")</span>
            <span>Lock cursor to window bounds</span>
        </label>
    </div>

    <div class="nb-display-pane__right">
        <ResultPreview MonitorWidth="PreviewMonitorWidth" MonitorHeight="PreviewMonitorHeight"
                       WindowWidth="State.Width" WindowHeight="State.Height"
                       OffsetX="State.OffsetX" OffsetY="State.OffsetY"
                       Caption="@PreviewCaption" />

        <div class="nb-display-pane__summary">
            <div class="nb-display-pane__summary-text nb-mono nb-display-pane__summary-text--@SummaryClass()">@SummaryText()</div>
            <div class="nb-display-pane__align-row">
                <MonitorAlignButton Position="MonitorAlignMode.Left" Title="Align left, centered vertically" OnClick="@(() => OnAlign(MonitorAlignMode.Left))" />
                <MonitorAlignButton Position="MonitorAlignMode.Center" Title="Center on monitor" OnClick="@(() => OnAlign(MonitorAlignMode.Center))" />
                <MonitorAlignButton Position="MonitorAlignMode.Bottom" Title="Align bottom, centered horizontally" OnClick="@(() => OnAlign(MonitorAlignMode.Bottom))" />
                <MonitorAlignButton Position="MonitorAlignMode.Right" Title="Align right, centered vertically" OnClick="@(() => OnAlign(MonitorAlignMode.Right))" />
            </div>
        </div>

        <div class="nb-display-pane__actions">
            <button type="button" class="nb-btn nb-btn--primary @_saveFlash.CssClass" @onclick="OnSaveChanges">Save Changes</button>
            <button type="button" class="nb-btn nb-btn--outline nb-btn--compact" title="Undo last change" disabled="@(!State.CanUndo)" @onclick="() => State.Undo()">↶ Undo</button>
            <button type="button" class="nb-btn nb-btn--outline @_loadDefaultsFlash.CssClass" @onclick="OnLoadMonitorDefaults">Load Monitor Defaults</button>
        </div>
    </div>
</div>

@code {
    private readonly FlashFeedback _saveFlash;
    private readonly FlashFeedback _loadDefaultsFlash;
    public DisplayDetailPane()
    {
        _saveFlash = new FlashFeedback(StateHasChanged);
        _loadDefaultsFlash = new FlashFeedback(StateHasChanged);
    }

    protected override void OnInitialized() => State.Changed += OnStateChanged;
    public void Dispose() => State.Changed -= OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private GameConfig? DisplayedGame => State.SelectedGame ?? State.Games.FirstOrDefault();

    private string TargetMonitorName =>
        !string.IsNullOrEmpty(State.ActiveMonitorScope) ? State.ActiveMonitorScope :
        DisplayedGame?.Profiles.Keys.FirstOrDefault()
        ?? (State.Monitors.FirstOrDefault(m => m.Primary) ?? State.Monitors.FirstOrDefault())?.ID
        ?? State.KnownMonitors.FirstOrDefault()
        ?? string.Empty;

    private void OnMonitorChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrEmpty(value)) return;
        EnsureSelected();
        State.SelectMonitorScope(value);
    }

    // Write actions below all guard on the real selected game, which can
    // still be null while DisplayedGame shows a display-only fallback.
    // Establish the real selection first so a click against what's visibly
    // shown never silently no-ops.
    private void EnsureSelected()
    {
        if (State.SelectedGame == null && DisplayedGame != null)
            State.SelectGame(DisplayedGame);
    }

    private async Task OnLoadMonitorDefaults()
    {
        EnsureSelected();
        State.LoadMonitorDefaults();
        await _loadDefaultsFlash.Trigger();
    }

    private void AdjustWidth(int delta) { EnsureSelected(); State.AdjustWidth(delta); }
    private void AdjustHeight(int delta) { EnsureSelected(); State.AdjustHeight(delta); }
    private void AdjustOffsetX(int delta) { EnsureSelected(); State.AdjustOffsetX(delta); }
    private void AdjustOffsetY(int delta) { EnsureSelected(); State.AdjustOffsetY(delta); }

    private void OnToggleConstrainMouse() { EnsureSelected(); State.ToggleConstrainMouse(); }

    private async Task OnSaveChanges()
    {
        EnsureSelected();
        State.SaveGameChanges();
        await _saveFlash.Trigger();
    }

    private void OnAlign(MonitorAlignMode mode)
    {
        EnsureSelected();
        State.AlignOnMonitor(mode);
    }

    // Only known live while the target monitor is actually connected.
    private MonitorItem? TargetMonitorConnected =>
        State.Monitors.FirstOrDefault(m => m.ID == TargetMonitorName);

    // Falls back to the last resolution ever recorded for this monitor ID
    // when it isn't currently connected, so preview/coverage math keeps
    // working instead of going blank the moment a monitor is unplugged. Null
    // only when this monitor has never been seen connected at all.
    private (int Width, int Height)? KnownMonitorResolution
    {
        get
        {
            if (TargetMonitorConnected is { } m) return (m.Width, m.Height);
            var cached = State.GetLastKnownMonitorResolution(TargetMonitorName);
            return cached != null ? (cached.Width, cached.Height) : null;
        }
    }

    // Reads the live shadow fields (State.Width/Height/OffsetX/OffsetY), not
    // a persisted-profile lookup, so the preview/summary line moves as you
    // step the fields rather than only after Save Changes. Routed through
    // KnownMonitorResolution rather than falling back to the window's own
    // size, which would make MonitorWidth==WindowWidth by construction and
    // force the preview box to always render at full size when the target
    // monitor isn't connected.
    private int PreviewMonitorWidth  => KnownMonitorResolution?.Width  ?? 0;
    private int PreviewMonitorHeight => KnownMonitorResolution?.Height ?? 0;

    private string PreviewCaption
    {
        get
        {
            bool fullCoverage = State.OffsetX == 0 && State.OffsetY == 0
                && State.Width == PreviewMonitorWidth && State.Height == PreviewMonitorHeight;
            string core = $"{State.Width}×{State.Height} @ {State.OffsetX},{State.OffsetY}";
            return fullCoverage ? $"{core} — full coverage" : core;
        }
    }

    private int? CoveragePercent
    {
        get
        {
            var res = KnownMonitorResolution;
            if (res is not { } r || r.Width <= 0 || r.Height <= 0) return null;
            return (int)Math.Round((double)(State.Width * State.Height) / (r.Width * r.Height) * 100);
        }
    }

    private bool? FitsOnScreen
    {
        get
        {
            var res = KnownMonitorResolution;
            if (res is not { } r) return null;
            return State.OffsetX >= 0 && State.OffsetY >= 0
                && State.OffsetX + State.Width <= r.Width
                && State.OffsetY + State.Height <= r.Height;
        }
    }

    private string SummaryClass() =>
        DisplayedGame == null || CoveragePercent == null ? "neutral" : (FitsOnScreen == true ? "ok" : "warning");

    private string SummaryText()
    {
        if (DisplayedGame == null) return "no game selected";
        if (string.IsNullOrEmpty(TargetMonitorName)) return "no monitor available";
        string core = $"{State.Width}×{State.Height} @ {State.OffsetX},{State.OffsetY}";
        if (CoveragePercent is not int pct) return $"{core} — {TargetMonitorName} not connected, coverage unknown";
        string fit = FitsOnScreen == true ? "fits on screen" : "out of bounds";
        string suffix = TargetMonitorConnected == null ? " (last known)" : "";
        return $"{core} — {pct}% of {TargetMonitorName}{suffix} · {fit}";
    }
}
