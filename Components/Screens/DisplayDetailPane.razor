@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State
@implements IDisposable
@* Screen 2a's right-pane content (Display tab), design-handoff/README.md
   §"2a — Main window, Display tab".

   Phase 4.1: subscribes to AppStateService.Changed directly rather than
   relying on MainShell's own re-render to cascade down through the
   RightPane RenderFragment — that cascade turned out NOT to reliably
   reach this component in practice (confirmed live: selecting a different
   rail row updated MainShell's hero/rail but left this pane showing the
   previously-selected game's profile). Every component that reads
   AppStateService now subscribes for itself; see MainShell.razor for the
   same pattern.

   Phase 3.6: Width/Height/Offset X/Offset Y/Lock-cursor and the Result
   Preview (screen 3a's component) are wired to the selected game's real
   resolved profile, using the exact same fallback chain as
   MainForm.GetEffectiveProfile()/BtnLoadDefaults_Click — the game's own
   saved Profiles[monitor] if any, else that monitor's MonitorDefaults
   entry, else GameDisplayProfile's own 1920×1080 schema default.

   Phase 4.2: TARGET MONITOR is a real, functional dropdown (a native
   <select>, restyled — the mock's exact custom popup list isn't
   reproduced pixel-for-pixel, which is a real fidelity gap left for a
   Phase 6 polish pass if wanted, same tradeoff class as Phase 6.2/6.4's
   deferred items). Selecting an option calls
   AppStateService.SelectMonitorScope, which forwards to MainForm's
   SelectMonitorScope -> the real, unchanged CmbMonitor_SelectedIndexChanged.
   TargetMonitorName now prefers the real AppStateService.ActiveMonitorScope
   (MainForm's _activeScope) once it's been set by a selection — from either
   UI — falling back to the same display-only pick as before (first saved
   profile's monitor, else primary connected, else first known name) only
   for the window before any selection has ever happened.

   3a's coverage %/fits-on-screen summary line (`w*h / mw*mh`, per the
   README's implementation note) didn't exist as static UI from Phase 2 —
   this is the first place it's built, since the math has nothing real to
   compute against until now. Coverage needs the monitor's actual physical
   resolution, which — like the Settings > Monitors page's saved-
   disconnected cards (Phase 3.5) — is only knowable while that monitor is
   currently connected (AppStateService.Monitors); a saved profile for a
   now-unplugged monitor honestly shows "monitor not connected" instead of
   a fabricated percentage.

   Phase 4.4: "Load Monitor Defaults" calls AppStateService.LoadMonitorDefaults,
   which forwards to MainForm's real BtnLoadDefaults_Click via PerformClick() —
   loads the active scope's saved MonitorDefaults entry onto the selected
   game and immediately persists/enforces it, exactly as the WinForms button
   always has.

   Phase 4.6: Save Changes calls AppStateService.SaveGameChanges, shared with
   MatchingDetailPane's own Save Changes button (README: "both tabs share
   Save Changes / Undo"). Width/Height/Offset/Lock-cursor here are still
   read-only display (SteppedNumberField has no click handling yet — the
   README's ±1/Shift±10/Ctrl±100 stepper interaction isn't itemized anywhere
   in Phase 4 and is being treated as out of this migration's scope, not an
   oversight), so today Save Changes mainly re-commits the pending display
   name (see MatchingDetailPane) and re-persists whatever profile is already
   loaded — a real, working round-trip, just not yet a way to change the
   numbers from Blazor. Undo/Center On Monitor remain static (Phase 4.13/6). *@

<div class="nb-display-pane">
    <div class="nb-display-pane__left">
        <div class="nb-text-label nb-display-pane__label">TARGET MONITOR</div>
        <div class="nb-display-pane__select">
            @if (State.MonitorOptions.Count == 0)
            {
                <select class="nb-display-pane__select-native" disabled>
                    <option>No monitor</option>
                </select>
            }
            else
            {
                <select class="nb-display-pane__select-native" @onchange="OnMonitorChanged">
                    @foreach (var m in State.MonitorOptions)
                    {
                        <option value="@m" selected="@(m == TargetMonitorName)">@m</option>
                    }
                </select>
            }
            <span class="nb-display-pane__select-caret">▾</span>
        </div>

        <div class="nb-display-pane__row">
            <div class="nb-display-pane__field">
                <div class="nb-text-label nb-display-pane__field-label">WIDTH</div>
                <SteppedNumberField Value="@DisplayedProfile.Width" />
            </div>
            <div class="nb-display-pane__field">
                <div class="nb-text-label nb-display-pane__field-label">HEIGHT</div>
                <SteppedNumberField Value="@DisplayedProfile.Height" />
            </div>
        </div>

        <div class="nb-display-pane__row nb-display-pane__row--offsets">
            <div class="nb-display-pane__field">
                <div class="nb-text-label nb-display-pane__field-label">OFFSET X</div>
                <SteppedNumberField Value="@DisplayedProfile.OffsetX" BorderSubtle="true" />
            </div>
            <div class="nb-display-pane__field">
                <div class="nb-text-label nb-display-pane__field-label">OFFSET Y</div>
                <SteppedNumberField Value="@DisplayedProfile.OffsetY" BorderSubtle="true" />
            </div>
        </div>

        <div class="nb-text-subline nb-display-pane__hint">Arrows step by 1 px · hold Shift for 10 · Ctrl for 100</div>

        <label class="nb-display-pane__check">
            <span class="nb-display-pane__check-box @(DisplayedProfile.ConstrainMouse ? "nb-display-pane__check-box--checked" : "")">@(DisplayedProfile.ConstrainMouse ? "✓" : "")</span>
            <span>Lock cursor to window bounds</span>
        </label>
    </div>

    <div class="nb-display-pane__right">
        <ResultPreview MonitorWidth="PreviewMonitorWidth" MonitorHeight="PreviewMonitorHeight"
                       WindowWidth="DisplayedProfile.Width" WindowHeight="DisplayedProfile.Height"
                       OffsetX="DisplayedProfile.OffsetX" OffsetY="DisplayedProfile.OffsetY"
                       Caption="@PreviewCaption" />

        <div class="nb-display-pane__summary">
            <div class="nb-display-pane__summary-text nb-mono nb-display-pane__summary-text--@SummaryClass()">@SummaryText()</div>
            <div class="nb-display-pane__center-link nb-mono">Center On Monitor</div>
        </div>

        <div class="nb-display-pane__actions">
            <button type="button" class="nb-btn nb-btn--primary" @onclick="OnSaveChanges">Save Changes</button>
            <button type="button" class="nb-btn nb-btn--outline nb-btn--compact" title="Undo last change">↶ Undo</button>
            <button type="button" class="nb-btn nb-btn--outline" @onclick="OnLoadMonitorDefaults">Load Monitor Defaults</button>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    public void Dispose() => State.Changed -= OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private GameConfig? DisplayedGame => State.SelectedGame ?? State.Games.FirstOrDefault();

    private string TargetMonitorName =>
        !string.IsNullOrEmpty(State.ActiveMonitorScope) ? State.ActiveMonitorScope :
        DisplayedGame?.Profiles.Keys.FirstOrDefault()
        ?? (State.Monitors.FirstOrDefault(m => m.Primary) ?? State.Monitors.FirstOrDefault())?.ID
        ?? State.KnownMonitors.FirstOrDefault()
        ?? string.Empty;

    private void OnMonitorChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (!string.IsNullOrEmpty(value)) State.SelectMonitorScope(value);
    }

    // Write actions below all guard on MainForm's real _selectedGame, which
    // can still be null while DisplayedGame is only showing the Phase 3.3
    // display-only fallback. Same fix as MainShell's hero button (Phase 4.3):
    // establish the real selection first so a click against what's visibly
    // shown never silently no-ops.
    private void EnsureSelected()
    {
        if (State.SelectedGame == null && DisplayedGame != null)
            State.SelectGame(DisplayedGame);
    }

    private void OnLoadMonitorDefaults()
    {
        EnsureSelected();
        State.LoadMonitorDefaults();
    }

    private void OnSaveChanges()
    {
        EnsureSelected();
        State.SaveGameChanges();
    }

    // Same fallback chain as MainForm.GetEffectiveProfile(): the game's own
    // saved profile for this monitor, else that monitor's saved default,
    // else GameDisplayProfile's own schema default.
    private GameDisplayProfile DisplayedProfile
    {
        get
        {
            if (DisplayedGame != null && !string.IsNullOrEmpty(TargetMonitorName)
                && DisplayedGame.Profiles.TryGetValue(TargetMonitorName, out var gp))
                return gp;
            if (!string.IsNullOrEmpty(TargetMonitorName) && State.MonitorDefaults.TryGetValue(TargetMonitorName, out var def))
                return def;
            return new GameDisplayProfile();
        }
    }

    // Only known while the target monitor is actually connected — a saved
    // profile for an unplugged monitor has no physical resolution on file.
    private MonitorItem? TargetMonitorConnected =>
        State.Monitors.FirstOrDefault(m => m.ID == TargetMonitorName);

    private int PreviewMonitorWidth  => TargetMonitorConnected?.Width  ?? DisplayedProfile.Width;
    private int PreviewMonitorHeight => TargetMonitorConnected?.Height ?? DisplayedProfile.Height;

    private string PreviewCaption
    {
        get
        {
            var p = DisplayedProfile;
            bool fullCoverage = p.OffsetX == 0 && p.OffsetY == 0
                && p.Width == PreviewMonitorWidth && p.Height == PreviewMonitorHeight;
            string core = $"{p.Width}×{p.Height} @ {p.OffsetX},{p.OffsetY}";
            return fullCoverage ? $"{core} — full coverage" : core;
        }
    }

    // README's implementation note: "percentage is area coverage (w*h / mw*mh)".
    private int? CoveragePercent
    {
        get
        {
            var m = TargetMonitorConnected;
            if (m == null || m.Width <= 0 || m.Height <= 0) return null;
            var p = DisplayedProfile;
            return (int)Math.Round((double)(p.Width * p.Height) / (m.Width * m.Height) * 100);
        }
    }

    // README: "'fits on screen' flips to a warning when offset + size exceeds monitor bounds".
    private bool? FitsOnScreen
    {
        get
        {
            var m = TargetMonitorConnected;
            if (m == null) return null;
            var p = DisplayedProfile;
            return p.OffsetX >= 0 && p.OffsetY >= 0
                && p.OffsetX + p.Width <= m.Width
                && p.OffsetY + p.Height <= m.Height;
        }
    }

    private string SummaryClass() =>
        DisplayedGame == null || CoveragePercent == null ? "neutral" : (FitsOnScreen == true ? "ok" : "warning");

    private string SummaryText()
    {
        if (DisplayedGame == null) return "no game selected";
        if (string.IsNullOrEmpty(TargetMonitorName)) return "no monitor available";
        var p = DisplayedProfile;
        string core = $"{p.Width}×{p.Height} @ {p.OffsetX},{p.OffsetY}";
        if (CoveragePercent is not int pct) return $"{core} — {TargetMonitorName} not connected, coverage unknown";
        string fit = FitsOnScreen == true ? "fits on screen" : "out of bounds";
        return $"{core} — {pct}% of {TargetMonitorName} · {fit}";
    }
}
