@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State

<div class="nb-wctl__divider"></div>
<div class="nb-wctl">
    <button type="button" class="nb-wctl__btn" aria-label="Minimize" @onmousedown:stopPropagation="true" @onclick="() => State.MinimizeWindow()">—</button>
    <button type="button" class="nb-wctl__btn" aria-label="@(State.IsWindowMaximized ? "Restore" : "Maximize")" @onmousedown:stopPropagation="true" @onclick="() => State.ToggleMaximizeWindow()">@(State.IsWindowMaximized ? "❐" : "▢")</button>
    <button type="button" class="nb-wctl__btn nb-wctl__btn--close" aria-label="Close" @onmousedown:stopPropagation="true" @onclick="() => State.CloseWindow()">✕</button>
</div>
