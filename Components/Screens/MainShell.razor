@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State
@implements IDisposable
@*
    Shared shell for screens 2a (Display tab) and 5a (Matching tab) — title
    strip, hero, and library rail are identical between the two per
    design-handoff/README.md ("5a — Same shell as 2a; only the right pane
    differs.").

    Phase 3.3: rail + hero wired to the real AppStateService.Games list and
    AppStateService.SelectedGame. Phase 4.1: rail rows are clickable —
    @onclick calls State.SelectGame(g), which forwards to MainForm's
    SelectGame(), which sets `_lstGames.SelectedIndex` so the real, unchanged
    `LstGames_SelectedIndexChanged` handler runs exactly as it would from the
    WinForms list. That handler doesn't know Blazor exists, so this component
    subscribes to AppStateService.Changed (raised by MainForm right after)
    and re-renders from it — see AppStateService's doc comment for the full
    rationale. When nothing is selected yet (SelectedGame is null — true
    until the first click, from either UI), DisplayedGame falls back to
    Games.FirstOrDefault() purely for *display*; it never writes
    _selectedGame itself, so the rail's "selected" highlight and the hero
    both stay honestly in sync with whatever's actually being shown.

    Adaptation Decision #1 (MIGRATION_PLAN.md "Resolved decisions"):
    MainForm keeps its native title bar, so the mock's window-control
    glyphs (— ▢ ✕) and the divider that separated them from the Settings
    button are intentionally dropped here — only the wordmark/version
    chip/Settings button remain as a thin in-content header row.
*@

<div class="nb-shell">
    <header class="nb-shell__titlebar">
        <div class="nb-shell__mark"></div>
        <div class="nb-text-wordmark nb-shell__wordmark">NOBORDERS</div>
        <div class="nb-text-data nb-shell__version">v2.4</div>
        <div class="nb-shell__spacer"></div>
        <button type="button" class="nb-shell__settings-btn">
            <span class="nb-shell__settings-ring"></span>Settings
        </button>
    </header>

    <section class="nb-shell__hero">
        <div class="nb-shell__hero-scrim"></div>
        <div class="nb-shell__hero-caption nb-mono">hero art 16:5</div>
        <div class="nb-shell__hero-content">
            <div class="nb-shell__hero-status-block">
                <div class="nb-shell__hero-status">
                    <span class="nb-shell__hero-status-dot @(IsDisplayedActive ? "" : "nb-shell__hero-status-dot--inactive")"></span>
                    <span class="nb-text-label nb-shell__hero-status-text @(IsDisplayedActive ? "" : "nb-shell__hero-status-text--inactive")">
                        @(IsDisplayedActive ? "BORDERLESS APPLIED" : "INACTIVE")
                    </span>
                </div>
                <div class="nb-text-hero nb-shell__hero-title">@(DisplayedGame?.GameName ?? "No games yet")</div>
                <div class="nb-shell__hero-meta nb-mono">@HeroMetaLine(DisplayedGame)</div>
            </div>
            <div class="nb-shell__hero-actions">
                <button type="button" class="nb-shell__hero-btn nb-shell__hero-btn--primary" disabled="@(DisplayedGame == null)">
                    @(IsDisplayedActive ? "Disable Borderless" : "Enable Borderless")
                </button>
                <button type="button" class="nb-shell__hero-btn nb-shell__hero-btn--secondary" disabled="@(DisplayedGame == null)">Re-Apply</button>
            </div>
        </div>
    </section>

    <div class="nb-shell__body">
        <aside class="nb-shell__rail">
            <div class="nb-shell__rail-filter">
                <div class="nb-shell__rail-filter-field">Filter…</div>
                <button type="button" class="nb-shell__rail-add" aria-label="Add game">＋</button>
            </div>
            <div class="nb-text-label nb-shell__rail-heading">LIBRARY · @State.Games.Count</div>
            @foreach (var g in State.Games)
            {
                var selected = g == DisplayedGame;
                var tier = RowTier(g, selected);
                <div class="nb-shell__rail-row @(selected ? "nb-shell__rail-row--selected" : "")" @onclick="() => State.SelectGame(g)">
                    <div class="nb-shell__rail-thumb @(selected ? "nb-shell__rail-thumb--selected" : "")"></div>
                    <div class="nb-shell__rail-info">
                        <div class="nb-shell__rail-name nb-shell__rail-name--@tier">@g.GameName</div>
                        <div class="nb-shell__rail-res nb-shell__rail-res--@tier nb-mono">@RailResolution(g)</div>
                    </div>
                    @if (g.IsActive)
                    {
                        <div class="nb-shell__rail-on nb-mono">ON</div>
                    }
                </div>
            }
        </aside>

        <div class="nb-shell__right">
            <div class="nb-shell__tabs">
                <div class="nb-shell__tab @(ActiveTab == ShellTab.Display ? "nb-shell__tab--active" : "")">Display</div>
                <div class="nb-shell__tab @(ActiveTab == ShellTab.Matching ? "nb-shell__tab--active" : "")">Matching</div>
            </div>
            @RightPane
        </div>
    </div>

    <footer class="nb-shell__statusbar nb-text-statusbar">
        <span>Ctrl+Shift+A add</span>
        <span>Ctrl+Shift+R refresh</span>
        <div class="nb-shell__statusbar-spacer"></div>
        <span>standard user</span>
    </footer>
</div>

@code {
    public enum ShellTab { Display, Matching }

    [Parameter] public ShellTab ActiveTab { get; set; } = ShellTab.Display;
    [Parameter] public RenderFragment? RightPane { get; set; }

    protected override void OnInitialized() => State.Changed += OnStateChanged;
    public void Dispose() => State.Changed -= OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // Display-only fallback: never writes MainForm's real _selectedGame, just
    // picks something sensible to show/highlight when nothing is selected yet.
    private GameConfig? DisplayedGame => State.SelectedGame ?? State.Games.FirstOrDefault();

    private bool IsDisplayedActive => DisplayedGame?.IsActive == true;

    // A GameConfig's Profiles dictionary is keyed by monitor friendly-name, so
    // "the" resolution/offset/monitor isn't well-defined without a selected
    // scope — that's the Target Monitor dropdown's job (DisplayDetailPane),
    // not wired until later. Until then, this shows the first saved profile,
    // if any, which is honest about being a placeholder pick rather than a
    // resolved "current" one.
    private static string RailResolution(GameConfig g)
    {
        var p = g.Profiles.Values.FirstOrDefault();
        return p == null ? "no profile saved" : $"{p.Width}×{p.Height}";
    }

    private static string HeroMetaLine(GameConfig? g)
    {
        if (g == null) return string.Empty;
        var monitor = g.Profiles.Keys.FirstOrDefault();
        if (monitor == null || !g.Profiles.TryGetValue(monitor, out var p))
            return "no display profile saved yet";
        string offsetX = p.OffsetX >= 0 ? $"+{p.OffsetX}" : p.OffsetX.ToString();
        string offsetY = p.OffsetY >= 0 ? $"+{p.OffsetY}" : p.OffsetY.ToString();
        string cursor  = p.ConstrainMouse ? "cursor locked" : "cursor free";
        return $"{p.Width}×{p.Height} · {offsetX},{offsetY} · {monitor} · {cursor}";
    }

    // Text color tier follows (selected, active) exactly as the mock's
    // literal per-row colors do: selected+ON is brightest, ON-but-unselected
    // is next, and rows with no ON pill are dimmest.
    private static string RowTier(GameConfig g, bool selected) =>
        selected ? "selected" : g.IsActive ? "active" : "inactive";
}
