@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State
@inject ArtworkService Artwork

<ModalOverlay Width="560">
    <div class="nb-add-app__header">
        <div class="nb-add-app__title">Add a running app</div>
        <div class="nb-add-app__subline">@(_adding ? "Adding — checking for matching artwork…" : "System processes are hidden. Pick the window you want to go borderless.")</div>
        <div class="nb-add-app__search">
            <span class="nb-add-app__search-ring"></span>
            <span>Search @(Rows.Count) window@(Rows.Count == 1 ? "" : "s")…</span>
        </div>
    </div>

    <div class="nb-add-app__rows">
        @foreach (var row in Rows)
        {
            bool selected = _selected.HasValue && _selected.Value.Equals(row);
            bool tracked = IsTracked(row);
            <div @key="row" class="nb-add-app__row @(selected ? "nb-add-app__row--selected" : "")" @onclick="() => _selected = row">
                <div class="nb-add-app__thumb @(selected ? "nb-add-app__thumb--selected" : "")"></div>
                <div class="nb-add-app__info">
                    <div class="nb-add-app__name @(selected ? "nb-add-app__name--selected" : "")">@row.WindowTitle</div>
                    <div class="nb-add-app__detail nb-mono">@row.Exe · PID @row.Pid</div>
                </div>
                @if (selected)
                {
                    <div class="nb-add-app__check">✓</div>
                }
                else if (tracked)
                {
                    <div class="nb-add-app__tracked nb-mono">TRACKED</div>
                }
            </div>
        }
    </div>

    <div class="nb-add-app__footer">
        <div class="nb-add-app__tip">
            @if (AddHotkeyHint != null)
            {
                <text>Tip: press <span class="nb-mono nb-add-app__tip-key">@AddHotkeyHint</span> in-game to add the focused window.</text>
            }
            <div class="nb-add-app__browse" @onclick="Browse">Not running? Browse for EXE…</div>
        </div>
        <button type="button" class="nb-btn nb-btn--outline nb-add-app__cancel" @onclick="Cancel" disabled="@_adding">Cancel</button>
        <button type="button" class="nb-btn nb-btn--primary nb-add-app__add" disabled="@(_selected == null || _adding)" @onclick="AddSelected">@(_adding ? "Adding…" : "Add Game")</button>
    </div>
</ModalOverlay>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private List<OpenWindowEntry> Rows => State.GetOpenWindows();

    private OpenWindowEntry? _selected;
    private bool _adding;

    private bool IsTracked(OpenWindowEntry row) => State.Games.Any(g => g.IsMatch(row.Exe, row.WindowTitle));

    private string? AddHotkeyHint => HintOrNull(State.HotkeyAddApp);

    private static string? HintOrNull(HotkeyConfig cfg)
    {
        string text = cfg.ToString();
        return text == "None" ? null : text;
    }

    private async Task Cancel() => await OnClose.InvokeAsync();

    private async Task Browse()
    {
        if (_adding) return;
        _adding = true;
        StateHasChanged();

        if (State.BrowseForExe() && State.SelectedGame is { } newGame)
            await TryAutoFetchArtwork(newGame);

        await OnClose.InvokeAsync();
    }

    private async Task AddSelected()
    {
        if (_selected is not { } entry || _adding) return;
        _adding = true;
        StateHasChanged();

        if (State.AddGameFromRunningWindow(entry) && State.SelectedGame is { } newGame)
            await TryAutoFetchArtwork(newGame);

        await OnClose.InvokeAsync();
    }

    private async Task TryAutoFetchArtwork(GameConfig game)
    {
        string slug = string.IsNullOrEmpty(game.ExePath) ? game.GameName : game.ExePath;
        var auto = await Artwork.TryAutoFetchAsync(game.GameName, slug);
        if (auto.HeroPath != null || auto.IconPath != null)
            State.ApplyArtwork(auto.HeroPath ?? game.HeroImagePath, auto.IconPath ?? game.IconImagePath);
    }
}
