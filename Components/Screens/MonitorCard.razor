@namespace NoBorders.Components.Screens

<div class="nb-monitor-card @VariantClass" @onclick="OnCardClick">
    <div class="nb-monitor-card__body">
        <div class="nb-monitor-card__name-row">
            @if (Primary)
            {
                <span class="nb-monitor-card__primary-dot" title="Primary monitor"></span>
            }
            <span class="nb-monitor-card__name">@Name</span>
        </div>
        <div class="nb-monitor-card__detail nb-mono">@Detail</div>
    </div>
    @if (Saved)
    {
        <button type="button" class="nb-monitor-card__remove" aria-label="Remove @Name" @onclick="OnRemoveClick" @onclick:stopPropagation="true">✕</button>
    }
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Detail { get; set; } = "";
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Saved { get; set; }
    [Parameter] public bool Primary { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    private string VariantClass =>
        (Saved ? "nb-monitor-card--saved " : "") +
        (Saved && Selected ? "nb-monitor-card--saved-selected" : !Saved && Selected ? "nb-monitor-card--selected" : "");

    private Task OnCardClick() => OnSelect.InvokeAsync();
    private Task OnRemoveClick() => OnRemove.InvokeAsync();
}
