@namespace NoBorders.Components.Screens

<div class="nb-modal-overlay">
    <div class="nb-modal-overlay__card" style="width:@(Width)px;border-color:@BorderColor;background:@Background">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public int Width { get; set; } = 560;
    [Parameter] public string BorderColor { get; set; } = "#2a2a36";
    [Parameter] public string Background { get; set; } = "var(--nb-base)";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
