@namespace NoBorders.Components.Screens
@using NoBorders
@using NoBorders.Services

<div class="nb-toast nb-toast--@LevelClass">
    <div class="nb-toast__row">
        <div class="nb-toast__thumb" style="@ThumbStyle"></div>
        <div class="nb-toast__body">
            <div class="nb-toast__status">
                <span class="nb-toast__dot"></span>
                <span class="nb-toast__title">@Title</span>
            </div>
            <div class="nb-toast__detail">@Detail</div>
            @if (ShowUndo)
            {
                <div class="nb-toast__undo nb-mono">Undo · Ctrl+Shift+Z</div>
            }
        </div>
    </div>
    <div class="nb-toast__progress-track">
        <div class="nb-toast__progress-fill"></div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Borderless applied";
    [Parameter] public string Detail { get; set; } = "Helldivers 2 → 2560×1440 on LG 27GP850";
    [Parameter] public LogLevel Level { get; set; } = LogLevel.Ok;
    [Parameter] public bool ShowUndo { get; set; } = false;

    [Parameter] public string IconUrl { get; set; } = "";

    private string ThumbStyle =>
        string.IsNullOrEmpty(IconUrl) ? "" : $"background-image:url('{ArtworkService.CssUrlEscape(IconUrl)}');background-size:cover;background-position:center;";

    private string LevelClass => Level switch
    {
        LogLevel.Error => "danger",
        LogLevel.Warn  => "warning",
        LogLevel.Info  => "warning",
        _              => "success",
    };
}
