@namespace NoBorders.Components.Screens

<SettingsShell Section="Section" OnBack="OnBack" OnSectionChange="OnSectionChange">
    @switch (Section)
    {
        case SettingsShell.SettingsSection.Monitors:
            <MonitorsSettingsPage />
            break;
        case SettingsShell.SettingsSection.Hotkeys:
            <HotkeysSettingsPage />
            break;
        case SettingsShell.SettingsSection.Behaviour:
            <BehaviourSettingsPage />
            break;
        case SettingsShell.SettingsSection.Artwork:
            <ArtworkSettingsPage />
            break;
        case SettingsShell.SettingsSection.IgnoreList:
            <IgnoreListSettingsPage />
            break;
        case SettingsShell.SettingsSection.Permissions:
            <PermissionsSettingsPage />
            break;
        case SettingsShell.SettingsSection.Diagnostics:
            <DiagnosticsSettingsPage OnOpenLog="OnOpenLog" />
            break;
        case SettingsShell.SettingsSection.About:
            <AboutSettingsPage />
            break;
    }
</SettingsShell>

@code {
    [Parameter] public SettingsShell.SettingsSection Section { get; set; } = SettingsShell.SettingsSection.Monitors;

    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<SettingsShell.SettingsSection> OnSectionChange { get; set; }
    [Parameter] public EventCallback OnOpenLog { get; set; }
}
