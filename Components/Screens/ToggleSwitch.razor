@namespace NoBorders.Components.Screens

<div class="nb-toggle @(On ? "nb-toggle--on" : "") @(Small ? "nb-toggle--small" : "")" @onclick="HandleClick">
    <div class="nb-toggle__knob"></div>
</div>

@code {
    [Parameter] public bool On { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    private Task HandleClick() => OnToggle.HasDelegate ? OnToggle.InvokeAsync() : Task.CompletedTask;
}
