@namespace NoBorders.Components.Screens

<button type="button" class="nb-align-btn" title="@Title" aria-label="@Title" @onclick="() => OnClick.InvokeAsync()">
    <svg width="20" height="15" viewBox="0 0 32 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="1" y="1" width="30" height="22" rx="3" stroke="currentColor" stroke-width="1.6" />
        <rect x="@WindowX" y="@WindowY" width="14" height="10" rx="1.5" fill="currentColor" />
    </svg>
</button>

@code {
    [Parameter] public MonitorAlignMode Position { get; set; } = MonitorAlignMode.Center;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public EventCallback OnClick { get; set; }

    private int WindowX => Position switch
    {
        MonitorAlignMode.Left  => 2,
        MonitorAlignMode.Right => 16,
        _                      => 9,
    };

    private int WindowY => Position == MonitorAlignMode.Bottom ? 12 : 7;
}
