@namespace NoBorders.Components.Screens
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject IJSRuntime JS

<div class="nb-numfield @(BorderSubtle ? "nb-numfield--subtle" : "")">
    @if (_editing)
    {
        <input @ref="_inputRef" class="nb-numfield__value nb-numfield__input nb-text-field-value"
               value="@_editText" @oninput="OnInput"
               @onblur="CommitEdit" @onkeydown="OnKeyDown"
               inputmode="numeric" />
    }
    else
    {
        <div class="nb-numfield__value nb-text-field-value" tabindex="0"
             @onclick="BeginEdit" @onfocus="BeginEdit">@Value</div>
    }
    <div class="nb-numfield__stepper">
        <button type="button" class="nb-numfield__btn" tabindex="-1" aria-label="Increase"
                @onmousedown="(e) => StartHold(e, 1)" @onmouseup="StopHold" @onmouseleave="StopHold">▲</button>
        <button type="button" class="nb-numfield__btn" tabindex="-1" aria-label="Decrease"
                @onmousedown="(e) => StartHold(e, -1)" @onmouseup="StopHold" @onmouseleave="StopHold">▼</button>
    </div>
</div>

@code {
    [Parameter] public int Value { get; set; }

    [Parameter] public bool BorderSubtle { get; set; }

    [Parameter] public EventCallback<int> OnStep { get; set; }

    private bool _editing;
    private bool _focusPending;
    private string _editText = "";
    private ElementReference _inputRef;

    private System.Threading.CancellationTokenSource? _holdCts;

    private async Task StartHold(MouseEventArgs e, int direction)
    {
        int baseMagnitude = e.CtrlKey ? 100 : e.ShiftKey ? 10 : 1;
        await OnStep.InvokeAsync(direction * baseMagnitude);

        _holdCts?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        _holdCts = cts;
        var token = cts.Token;

        try
        {
            await Task.Delay(350, token);
            var sw = System.Diagnostics.Stopwatch.StartNew();
            while (!token.IsCancellationRequested)
            {
                int magnitude = Math.Max(baseMagnitude, Math.Min(100, 1 + (int)(sw.ElapsedMilliseconds / 40)));
                await OnStep.InvokeAsync(direction * magnitude);
                await Task.Delay(60, token);
            }
        }
        catch (TaskCanceledException) { }
    }

    private void StopHold()
    {
        _holdCts?.Cancel();
        _holdCts = null;
    }

    private void BeginEdit()
    {
        _editText = Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _editing = true;
        _focusPending = true;
    }

    private void OnInput(ChangeEventArgs e) => _editText = e.Value?.ToString() ?? "";

    private Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") return CommitEdit();
        if (e.Key == "Escape")
        {
            _editText = Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _editing = false;
        }
        return Task.CompletedTask;
    }

    private Task CommitEdit()
    {
        _editing = false;
        if (int.TryParse(_editText, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out int typed))
        {
            int delta = typed - Value;
            if (delta != 0) return OnStep.InvokeAsync(delta);
        }
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending)
        {
            _focusPending = false;
            try { await JS.InvokeVoidAsync("nbNumField.selectAll", _inputRef); }
            catch (JSDisconnectedException) { }
        }
    }

    public void Dispose() => _holdCts?.Cancel();
}
