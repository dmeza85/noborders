@namespace NoBorders.Components.Screens
@* Reusable modal backdrop + centered card — screen 1d (Add Running App)
   is the first consumer; the elevation dialog (screen 1g, Phase 2.9) is
   a known second one. The mock's own "dv-card" framing doesn't specify a
   backdrop scrim (its design canvas just floats cards on the canvas
   background), so the dim-scrim treatment here is a reasonable,
   undocumented-but-necessary addition for an *actual* modal rather than
   a value transcribed from the mock. Static — no dismiss-on-backdrop-click
   wiring yet. *@

<div class="nb-modal-overlay">
    <div class="nb-modal-overlay__card" style="width:@(Width)px">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public int Width { get; set; } = 560;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
