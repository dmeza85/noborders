<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>NoBorders</AssemblyName>
    <RootNamespace>NoBorders</RootNamespace>

    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- "Borderless Gaming App UI/icon_export" source assets (README.md
         there) — packed into app.ico via wwwroot/img/MainForm.Tray.cs. This
         is what sets the taskbar/title-bar/Alt-Tab icon; TryExtractIcon
         (program.cs) reads it back via Icon.ExtractAssociatedIcon. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.90" />
  </ItemGroup>

  <!--
    review.md §5: NoBorders.Tests sits in a subdirectory of this project's own
    directory, so the SDK's default recursive globbing (**/*.cs, **/wwwroot/**
    etc.) would otherwise also pull its files — and its xunit references —
    into this project. Exclude that whole subtree explicitly. Same reasoning
    for "Borderless Gaming App UI" — the icon set's source SVGs/PNGs/README,
    kept for reference but not meant to be compiled/published as-is (the
    pieces actually used were copied into wwwroot/img, Resources/, and
    app.ico).
  -->
  <ItemGroup>
    <Compile Remove="NoBorders.Tests\**\*.cs" />
    <Content Remove="NoBorders.Tests\**" />
    <None Remove="NoBorders.Tests\**" />
    <Content Remove="Borderless Gaming App UI\**" />
    <None Remove="Borderless Gaming App UI\**" />
  </ItemGroup>

  <!-- Tray icon's theme-adaptive mono variants (MainForm.Tray.cs) — embedded
       so they travel inside the self-contained single-file publish output
       rather than needing loose files beside the exe. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\tray-16-dark.png" />
    <EmbeddedResource Include="Resources\tray-16-light.png" />
  </ItemGroup>

  <!--
    review.md §4.6: Microsoft.Web.WebView2 (pulled in transitively by the
    WindowsForms WebView package above) ships lib DLLs for every UI framework
    it supports — Core, WinForms, AND Wpf — and its buildTransitive targets
    reference all of them unconditionally, regardless of which one a
    consuming project actually uses. This app is WinForms-only (UseWpf is
    never set), so Microsoft.Web.WebView2.Wpf.dll is a dead reference here —
    but it still drags in WPF's WindowsBase 5.0.0.0, conflicting with the
    WindowsBase 4.0.0.0 the WinForms target itself references (MSB3277 on
    every build). Removing the WPF reference after it's resolved is the
    standard workaround for this well-documented WebView2 packaging quirk
    (see MicrosoftEdge/WebView2Feedback#1355) — deliberate, not a suppression
    of a real problem, since the WPF assembly is never loaded at runtime.
  -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>