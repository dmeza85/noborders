@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State

<div class="nb-elevation">
    <div class="nb-elevation__header">
        <div class="nb-elevation__icon">!</div>
        <div class="nb-elevation__title">@TitleText</div>
    </div>
    <div class="nb-elevation__body">@BodyText</div>
    @if (!string.IsNullOrEmpty(DetailLine))
    {
        <div class="nb-elevation__detail nb-mono">@DetailLine</div>
    }
    <div class="nb-elevation__actions">
        <div class="nb-elevation__spacer"></div>
        <button type="button" class="nb-btn nb-btn--outline nb-btn--compact" @onclick="() => State.DismissElevationDialog()">Not Now</button>
        <button type="button" class="nb-btn nb-btn--warning" @onclick="OnRestartClick">@ButtonText</button>
    </div>
</div>

@code {
    // Empty means the generic restart-as-admin trigger; non-empty names the
    // specific game that triggered an automatic elevation prompt. Ignored
    // when ToStandardUser is true (that direction has no per-game trigger).
    [Parameter] public string GameName { get; set; } = "";

    [Parameter] public bool ToStandardUser { get; set; } = false;

    private string TitleText => ToStandardUser
        ? "Restart without Administrator rights?"
        : "Administrator rights needed";

    private string BodyText => ToStandardUser
        ? "NoBorders will restart without Administrator privileges. Games or anti-cheat software running elevated may no longer be affected by borderless mode until you restart as Administrator again."
        : string.IsNullOrEmpty(GameName)
            ? "NoBorders will restart with Administrator privileges. This helps with games that run elevated (common with anti-cheat software like Vanguard, EAC, or BattlEye), which a non-elevated copy of NoBorders cannot modify."
            : $"NoBorders added “{GameName}”, but couldn’t fully apply borderless mode to its window — it (or its anti-cheat) is running with Administrator privileges while NoBorders is not.";

    private string DetailLine => ToStandardUser
        ? "Windows can't drop this process's own elevated rights — NoBorders relaunches itself instead."
        : string.IsNullOrEmpty(GameName)
            ? ""
            : "Windows blocks a non-elevated app from modifying an elevated window.";

    private string ButtonText => ToStandardUser ? "Restart Without Admin" : "Restart As Admin";

    // A successful restart exits the process outright, but a cancelled UAC
    // prompt or failed relaunch doesn't — dismiss explicitly first so a
    // declined/failed restart doesn't leave this dialog sitting open over
    // whatever status/toast feedback those paths show instead.
    private void OnRestartClick()
    {
        State.DismissElevationDialog();
        if (ToStandardUser)
            State.RestartAsStandardUser();
        else
            State.RestartAsAdmin();
    }
}
