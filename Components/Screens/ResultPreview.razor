@namespace NoBorders.Components.Screens

<div class="nb-preview">
    <div class="nb-text-label nb-preview__label">RESULT PREVIEW</div>
    <div class="nb-preview__well">
        @if (MonitorUnknown)
        {
            <div class="nb-preview__unknown nb-mono">Monitor not connected — preview unavailable</div>
        }
        else
        {
            <div class="nb-preview__monitor @(IsFullCoverage ? "" : "nb-preview__monitor--windowed")">
                @if (!IsFullCoverage)
                {
                    @if (OffsetX > 0)
                    {
                        <div class="nb-preview__band-x" style="@BandXStyle"></div>
                    }
                    @if (OffsetY > 0)
                    {
                        <div class="nb-preview__band-y" style="@BandYStyle"></div>
                    }
                    <div class="nb-preview__label-x nb-mono" style="@LabelXStyle">X @OffsetX</div>
                    <div class="nb-preview__label-y nb-mono" style="@LabelYStyle">Y @OffsetY</div>
                    <div class="nb-preview__label-monitor nb-mono">@MonitorWidth×@MonitorHeight monitor</div>
                }
                <div class="nb-preview__window @(IsFullCoverage ? "nb-preview__window--full" : "")" style="@WindowStyle">
                    <span class="nb-mono">@Caption</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int MonitorWidth { get; set; }
    [Parameter] public int MonitorHeight { get; set; }
    [Parameter] public int WindowWidth { get; set; }
    [Parameter] public int WindowHeight { get; set; }
    [Parameter] public int OffsetX { get; set; }
    [Parameter] public int OffsetY { get; set; }
    [Parameter] public string Caption { get; set; } = "";

    private const double WellWidth = 290;
    private const double WellHeight = 132;

    private double ScaleX => MonitorWidth > 0 ? WellWidth / MonitorWidth : 0;
    private double ScaleY => MonitorHeight > 0 ? WellHeight / MonitorHeight : 0;

    private bool MonitorUnknown => MonitorWidth <= 0 || MonitorHeight <= 0;

    private bool IsFullCoverage =>
        OffsetX == 0 && OffsetY == 0 &&
        WindowWidth == MonitorWidth && WindowHeight == MonitorHeight;

    private readonly record struct Rect(double Left, double Top, double Width, double Height);

    private Rect Geometry
    {
        get
        {
            double width  = Math.Clamp(WindowWidth  * ScaleX, 0, WellWidth);
            double height = Math.Clamp(WindowHeight * ScaleY, 0, WellHeight);
            double left   = Math.Clamp(OffsetX * ScaleX, 0, WellWidth  - width);
            double top    = Math.Clamp(OffsetY * ScaleY, 0, WellHeight - height);
            return new Rect(left, top, width, height);
        }
    }

    private string WindowStyle
    {
        get
        {
            if (IsFullCoverage) return string.Empty;
            var g = Geometry;
            return $"left:{Px(g.Left)};top:{Px(g.Top)};width:{Px(g.Width)};height:{Px(g.Height)}";
        }
    }

    private string BandXStyle => $"width:{Px(Geometry.Left)}";

    private string BandYStyle
    {
        get
        {
            var g = Geometry;
            return $"left:{Px(g.Left)};width:{Px(g.Width)};height:{Px(g.Top)}";
        }
    }

    private string LabelXStyle
    {
        get
        {
            var g = Geometry;
            return $"top:{Px(g.Top + g.Height / 2 - 4.5)}";
        }
    }

    private string LabelYStyle => $"left:{Px(Geometry.Left + 7)}";

    private static string Px(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";
}
