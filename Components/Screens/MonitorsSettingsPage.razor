@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State
@implements IDisposable

<div class="nb-monitors-page">
    <div class="nb-monitors-page__title">Monitor baseline defaults</div>
    <div class="nb-monitors-page__subline">New games added on a monitor inherit these values. Existing games keep their own.</div>

    <div class="nb-monitors-page__group-header">
        <div class="nb-text-label" style="color:var(--nb-success)">CONNECTED · @State.Monitors.Count</div>
        <div class="nb-monitors-page__hairline"></div>
    </div>
    <div class="nb-monitors-page__grid">
        @foreach (var m in State.Monitors)
        {
            <MonitorCard @key="m" Name="@m.ID" Detail="@ConnectedDetail(m)" Selected="@(m.ID == DisplayedMonitorName)" Primary="@m.Primary"
                         OnSelect="() => State.SelectMonitorDefaultScope(m.ID)" />
        }
    </div>

    <div class="nb-monitors-page__group-header nb-monitors-page__group-header--saved">
        <span class="nb-monitors-page__group-arrow @(_savedExpanded ? "nb-monitors-page__group-arrow--expanded" : "")"
              role="button" aria-label="@(_savedExpanded ? "Collapse" : "Expand") saved monitors"
              @onclick="() => _savedExpanded = !_savedExpanded"></span>
        <div class="nb-text-label">SAVED · NOT CONNECTED · @SavedDisconnected.Count</div>
        <div class="nb-monitors-page__hairline"></div>
        <div class="nb-monitors-page__remove-all" role="button" @onclick="() => State.RemoveAllSavedMonitors()">Remove All</div>
    </div>
    @if (_savedExpanded)
    {
        <div class="nb-monitors-page__grid">
            @foreach (var name in SavedDisconnected)
            {
                <MonitorCard @key="name" Name="@name" Detail="@SavedDetail(name)" Saved="true" Selected="@(name == DisplayedMonitorName)"
                             OnSelect="() => State.SelectMonitorDefaultScope(name)"
                             OnRemove="() => State.DeleteMonitorDefault(name)" />
            }
        </div>
        <div class="nb-monitors-page__caption">Saved monitors keep their defaults so profiles come back if the display is reconnected.</div>
    }

    <div class="nb-monitors-page__fields">
        <div class="nb-monitors-page__field">
            <div class="nb-text-label nb-monitors-page__field-label">WIDTH</div>
            <SteppedNumberField Value="@State.MonitorDefaultWidth" OnStep="@(delta => AdjustWidth(delta))" />
        </div>
        <div class="nb-monitors-page__field">
            <div class="nb-text-label nb-monitors-page__field-label">HEIGHT</div>
            <SteppedNumberField Value="@State.MonitorDefaultHeight" OnStep="@(delta => AdjustHeight(delta))" />
        </div>
        <div class="nb-monitors-page__field">
            <div class="nb-text-label nb-monitors-page__field-label">OFFSET X</div>
            <SteppedNumberField Value="@State.MonitorDefaultOffsetX" BorderSubtle="true" OnStep="@(delta => AdjustOffsetX(delta))" />
        </div>
        <div class="nb-monitors-page__field">
            <div class="nb-text-label nb-monitors-page__field-label">OFFSET Y</div>
            <SteppedNumberField Value="@State.MonitorDefaultOffsetY" BorderSubtle="true" OnStep="@(delta => AdjustOffsetY(delta))" />
        </div>
    </div>
    <div class="nb-text-subline nb-monitors-page__hint">Arrows step by 1 px · hold Shift for 10 · Ctrl for 100</div>

    <div class="nb-monitors-page__check-row">
        <label class="nb-monitors-page__check" @onclick="() => State.ToggleConstrainMouseDefault()">
            <span class="nb-monitors-page__check-box @(State.ConstrainMouseDefault ? "nb-monitors-page__check-box--checked" : "")"></span>
            <span>Lock cursor to window bounds by default</span>
        </label>
        <div class="nb-monitors-page__align-grid">
            @foreach (var opt in AlignOptions)
            {
                <div class="nb-monitors-page__align-btn" title="@opt.Title" @onclick="() => OnAlign(opt.Mode)">
                    <svg width="32" height="24" viewBox="0 0 32 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="1" y="1" width="30" height="22" rx="3" stroke="#4a4a58" stroke-width="1.6" />
                        <rect x="@AlignIconX(opt.Mode)" y="@AlignIconY(opt.Mode)" width="14" height="10" rx="1.5" fill="#5c5c6e" />
                    </svg>
                    <span class="nb-monitors-page__align-lbl">@opt.Label</span>
                </div>
            }
        </div>
    </div>

    <div class="nb-monitors-page__divider"></div>

    <div class="nb-monitors-page__preview-row">
        <div class="nb-monitors-page__actions">
            <button type="button" class="nb-btn nb-btn--primary @_saveDefaultFlash.CssClass" @onclick="OnSaveMonitorDefault">Save Monitor Default</button>
            <button type="button" class="nb-btn nb-btn--outline @_applyAllFlash.CssClass" @onclick="OnApplyToAllGames">Apply to All Games</button>
            <button type="button" class="nb-btn nb-btn--outline @_detectFlash.CssClass" @onclick="OnDetectDisplays">Detect Displays</button>
        </div>
        <div class="nb-monitors-page__preview-col">
            <ResultPreview MonitorWidth="PreviewMonitorWidth" MonitorHeight="PreviewMonitorHeight"
                           WindowWidth="State.MonitorDefaultWidth" WindowHeight="State.MonitorDefaultHeight"
                           OffsetX="State.MonitorDefaultOffsetX" OffsetY="State.MonitorDefaultOffsetY"
                           Caption="@PreviewCaption" />
        </div>
    </div>
</div>

@code {
    private readonly FlashFeedback _saveDefaultFlash;
    private readonly FlashFeedback _applyAllFlash;
    private readonly FlashFeedback _detectFlash;
    public MonitorsSettingsPage()
    {
        _saveDefaultFlash = new FlashFeedback(StateHasChanged);
        _applyAllFlash = new FlashFeedback(StateHasChanged);
        _detectFlash = new FlashFeedback(StateHasChanged);
    }

    protected override void OnInitialized() => State.Changed += OnStateChanged;
    public void Dispose() => State.Changed -= OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private bool _savedExpanded = false;

    private string DisplayedMonitorName =>
        !string.IsNullOrEmpty(State.ActiveMonitorDefaultScope) ? State.ActiveMonitorDefaultScope :
        (State.Monitors.FirstOrDefault(m => m.Primary) ?? State.Monitors.FirstOrDefault())?.ID
        ?? SavedDisconnected.FirstOrDefault()
        ?? string.Empty;

    private void EnsureMonitorDefaultSelected()
    {
        if (string.IsNullOrEmpty(State.ActiveMonitorDefaultScope) && !string.IsNullOrEmpty(DisplayedMonitorName))
            State.SelectMonitorDefaultScope(DisplayedMonitorName);
    }

    private async Task OnSaveMonitorDefault()
    {
        EnsureMonitorDefaultSelected();
        State.SaveMonitorDefault();
        await _saveDefaultFlash.Trigger();
    }

    private async Task OnDetectDisplays()
    {
        State.DetectDisplays();
        await _detectFlash.Trigger();
    }

    private async Task OnApplyToAllGames()
    {
        EnsureMonitorDefaultSelected();
        State.ApplyMonitorDefaultToAllGames();
        await _applyAllFlash.Trigger();
    }

    private void OnAlign(MonitorAlignMode mode)
    {
        EnsureMonitorDefaultSelected();
        State.AlignOnMonitorDefault(mode);
    }

    private static readonly (MonitorAlignMode Mode, string Label, string Title)[] AlignOptions =
    {
        (MonitorAlignMode.Left,   "Left + centered",   "Align left, centered vertically"),
        (MonitorAlignMode.Center, "True center",       "Center on monitor"),
        (MonitorAlignMode.Bottom, "Bottom + centered", "Align bottom, centered horizontally"),
        (MonitorAlignMode.Right,  "Right + centered",  "Align right, centered vertically"),
    };

    private static int AlignIconX(MonitorAlignMode mode) => mode switch
    {
        MonitorAlignMode.Left  => 2,
        MonitorAlignMode.Right => 16,
        _                      => 9,
    };

    private static int AlignIconY(MonitorAlignMode mode) => mode == MonitorAlignMode.Bottom ? 12 : 7;

    private void AdjustWidth(int delta) { EnsureMonitorDefaultSelected(); State.AdjustMonitorDefaultWidth(delta); }
    private void AdjustHeight(int delta) { EnsureMonitorDefaultSelected(); State.AdjustMonitorDefaultHeight(delta); }
    private void AdjustOffsetX(int delta) { EnsureMonitorDefaultSelected(); State.AdjustMonitorDefaultOffsetX(delta); }
    private void AdjustOffsetY(int delta) { EnsureMonitorDefaultSelected(); State.AdjustMonitorDefaultOffsetY(delta); }

    private MonitorItem? DisplayedConnectedMonitor =>
        State.Monitors.FirstOrDefault(m => m.ID == DisplayedMonitorName);

    private (int Width, int Height)? KnownMonitorResolution
    {
        get
        {
            if (DisplayedConnectedMonitor is { } m) return (m.Width, m.Height);
            var cached = State.GetLastKnownMonitorResolution(DisplayedMonitorName);
            return cached != null ? (cached.Width, cached.Height) : null;
        }
    }

    private int PreviewMonitorWidth  => KnownMonitorResolution?.Width  ?? 0;
    private int PreviewMonitorHeight => KnownMonitorResolution?.Height ?? 0;

    private string PreviewCaption
    {
        get
        {
            int w = State.MonitorDefaultWidth, h = State.MonitorDefaultHeight;
            int ox = State.MonitorDefaultOffsetX, oy = State.MonitorDefaultOffsetY;
            bool fullCoverage = ox == 0 && oy == 0 && w == PreviewMonitorWidth && h == PreviewMonitorHeight;
            string core = $"{w}×{h} @ {ox},{oy}";
            return fullCoverage ? $"{core} — full coverage" : core;
        }
    }

    private static string ConnectedDetail(MonitorItem m) =>
        m.Primary ? $"{m.Width}×{m.Height} · primary" : $"{m.Width}×{m.Height}";

    private List<string> SavedDisconnected =>
        State.KnownMonitors
            .Where(k => !State.Monitors.Any(m => string.Equals(m.ID, k, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(k => k, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private int GameCountFor(string monitorName) =>
        State.Games.Count(g => g.Profiles.ContainsKey(monitorName));

    private string SavedDetail(string monitorName)
    {
        int games = GameCountFor(monitorName);
        string gameText = $"{games} game{(games == 1 ? "" : "s")}";
        return State.MonitorDefaults.TryGetValue(monitorName, out var def)
            ? $"{def.Width}×{def.Height} default · {gameText}"
            : gameText;
    }
}
