@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State

<div class="nb-artwork-page__title">Artwork</div>
<div class="nb-artwork-page__subline">Personal API key for fetching hero banners and rail icons — free at <a class="nb-artwork-page__link" href="https://www.steamgriddb.com/profile/preferences/api">steamgriddb.com/profile/preferences/api</a>. Leave blank to use each game's own .exe icon only.</div>

<div class="nb-artwork-page__field">
    <div class="nb-text-label nb-artwork-page__field-label">STEAMGRIDDB API KEY</div>
    <input type="password" class="nb-artwork-page__input nb-mono" placeholder="Paste API key…" value="@State.ArtworkApiKey" @oninput="OnApiKeyInput" />
</div>

@code {
    private void OnApiKeyInput(ChangeEventArgs e) => State.SetArtworkApiKey(e.Value?.ToString() ?? "");
}
