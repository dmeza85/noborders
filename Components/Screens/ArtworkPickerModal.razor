@namespace NoBorders.Components.Screens
@using System.Linq
@using NoBorders.Services
@inject AppStateService State
@inject ArtworkService Artwork

<ModalOverlay Width="480">
    <div class="nb-art-picker__header">
        <div class="nb-art-picker__title">Fetch artwork</div>
        <div class="nb-art-picker__subline">@SublineText</div>
    </div>

    <div class="nb-art-picker__body">
        @if (_downloading)
        {
            <div class="nb-art-picker__status">Downloading art…</div>
        }
        else if (_search == null)
        {
            <div class="nb-art-picker__status">Searching…</div>
        }
        else if (_search.Status == ArtworkFetchStatus.NoApiKey)
        {
            <div class="nb-art-picker__status">
                No SteamGridDB API key set. Add one for free in
                <span class="nb-mono">Settings → Artwork</span>, or use this
                game's own icon below.
            </div>
        }
        else if (_search.Status == ArtworkFetchStatus.NoMatch)
        {
            <div class="nb-art-picker__status">No SteamGridDB matches found for "@Game.GameName".</div>
        }
        else if (_search.Status == ArtworkFetchStatus.NetworkError)
        {
            <div class="nb-art-picker__status nb-art-picker__status--error">Couldn't reach SteamGridDB@(string.IsNullOrEmpty(_search.Error) ? "." : $": {_search.Error}")</div>
        }
        else
        {
            <div class="nb-art-picker__rows">
                @foreach (var c in _search.Candidates)
                {
                    bool selected = _selected?.SteamGridDbId == c.SteamGridDbId;
                    <div @key="c.SteamGridDbId" class="nb-art-picker__row @(selected ? "nb-art-picker__row--selected" : "")" @onclick="() => _selected = c">
                        <div class="nb-art-picker__thumb @(selected ? "nb-art-picker__thumb--selected" : "")"></div>
                        <div class="nb-art-picker__name @(selected ? "nb-art-picker__name--selected" : "")">@c.Name</div>
                        @if (selected)
                        {
                            <div class="nb-art-picker__check">✓</div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (_error != null)
    {
        <div class="nb-art-picker__error nb-mono">@_error</div>
    }

    <div class="nb-art-picker__footer">
        <div class="nb-art-picker__fallback" @onclick="UseExeIconOnly">Use this game's own icon instead</div>
        <button type="button" class="nb-btn nb-btn--outline nb-art-picker__cancel" @onclick="Cancel" disabled="@_downloading">Cancel</button>
        <button type="button" class="nb-btn nb-btn--primary nb-art-picker__confirm" disabled="@(_selected == null || _downloading)" @onclick="ConfirmSelected">Fetch Artwork</button>
    </div>
</ModalOverlay>

@code {
    [Parameter] public GameConfig Game { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }

    private ArtworkSearchResult? _search;
    private ArtworkCandidate? _selected;
    private bool _downloading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        bool firstAttempt = string.IsNullOrEmpty(Game.HeroImagePath) && string.IsNullOrEmpty(Game.IconImagePath);
        if (firstAttempt)
        {
            var auto = await Artwork.TryAutoFetchAsync(Game.GameName, Slug);
            _search = auto.Search;
            if (auto.HeroPath != null || auto.IconPath != null)
            {
                State.ApplyArtwork(auto.HeroPath ?? Game.HeroImagePath, auto.IconPath ?? Game.IconImagePath);
                await OnClose.InvokeAsync();
                return;
            }
        }
        else
        {
            _search = await Artwork.SearchAsync(Game.GameName);
        }
    }

    private string Slug => string.IsNullOrEmpty(Game.ExePath) ? Game.GameName : Game.ExePath;

    private string SublineText
    {
        get
        {
            if (_downloading) return "Downloading the selected art…";
            if (_search == null) return $"Searching SteamGridDB for \"{Game.GameName}\"…";
            return _search.Status switch
            {
                ArtworkFetchStatus.Success => "Pick the closest match, or use the offline icon below.",
                _ => "SteamGridDB search finished.",
            };
        }
    }

    private async Task Cancel() => await OnClose.InvokeAsync();

    private async Task ConfirmSelected()
    {
        if (_selected is not { } candidate || _downloading) return;
        _downloading = true;
        _error = null;
        StateHasChanged();

        var result = await Artwork.DownloadAsync(candidate.SteamGridDbId, Slug);
        _downloading = false;

        if (result.Status != ArtworkFetchStatus.Success || (result.HeroPath == null && result.IconPath == null))
        {
            _error = result.Error ?? "That entry has no usable art uploaded — try a different match or use the offline icon.";
            StateHasChanged();
            return;
        }

        State.ApplyArtwork(result.HeroPath ?? Game.HeroImagePath, result.IconPath ?? Game.IconImagePath);
        await OnClose.InvokeAsync();
    }

    private async Task UseExeIconOnly()
    {
        string? iconPath = Artwork.ExtractExeIcon(Game.ExePath, Slug);
        NoBorders.AppLogger.LogVerbose($"ExtractExeIcon('{Game.ExePath}'): {(iconPath ?? "no ExePath on file / extraction failed")}.");
        if (iconPath == null)
        {
            _error = "Couldn't read an icon from this game's .exe.";
            StateHasChanged();
            return;
        }
        State.ApplyArtwork(Game.HeroImagePath, iconPath);
        await OnClose.InvokeAsync();
    }
}
