@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State
@* Real, wired-up revival of the Phase 2.9 elevation-prompt mockup (screen
   1g) — the original was static ("Not Now/Restart As Admin don't do
   anything yet") and was deleted rather than wired, in favor of a native
   MessageBox at the time. Moves that notification back into the app's own
   Blazor-rendered surface instead.

   Hosted in its own dedicated always-on-top Form (MainForm.ShowElevationDialog),
   same technique as Toast.razor/MainForm.ShowToast — not a docked
   ModalOverlay inside the main BlazorWebView, since this needs to stay
   visible even when the main window is minimized/hidden or a game is
   running fullscreen exclusive, exactly why the MessageBox it replaces
   used ShowTopmostMessageBox. This window IS the dialog, so — like
   Toast.razor — there's no outer backdrop/positioning here, just the
   card's own background/border/radius filling the host Form.

   Both buttons close the host Form immediately (MainForm wires OnNotOw/
   OnRestart to do so) — same one-shot interaction shape as the MessageBox
   Yes/No it replaces, rather than staying open after a choice is made. *@

<div class="nb-elevation">
    <div class="nb-elevation__header">
        <div class="nb-elevation__icon">!</div>
        <div class="nb-elevation__title">Administrator rights needed</div>
    </div>
    <div class="nb-elevation__body">@BodyText</div>
    @if (!string.IsNullOrEmpty(DetailLine))
    {
        <div class="nb-elevation__detail nb-mono">@DetailLine</div>
    }
    <div class="nb-elevation__actions">
        <div class="nb-elevation__spacer"></div>
        <button type="button" class="nb-btn nb-btn--outline nb-btn--compact" @onclick="() => State.DismissElevationDialog()">Not Now</button>
        <button type="button" class="nb-btn nb-btn--warning" @onclick="OnRestartClick">Restart As Admin</button>
    </div>
</div>

@code {
    // Empty means the generic "Settings > Permissions" trigger
    // (ConfirmRestartAsAdmin); non-empty means the automatic elevation-
    // blocked-on-add trigger (PromptRestartAsAdmin), which gets a more
    // specific message naming the game.
    [Parameter] public string GameName { get; set; } = "";

    private string BodyText => string.IsNullOrEmpty(GameName)
        ? "NoBorders will restart with Administrator privileges. This helps with games that run elevated (common with anti-cheat software like Vanguard, EAC, or BattlEye), which a non-elevated copy of NoBorders cannot modify."
        : $"NoBorders added “{GameName}”, but couldn’t fully apply borderless mode to its window — it (or its anti-cheat) is running with Administrator privileges while NoBorders is not.";

    private string DetailLine => string.IsNullOrEmpty(GameName)
        ? ""
        : "Windows blocks a non-elevated app from modifying an elevated window.";

    // Restarting closes this window's process outright (RestartAsAdmin's
    // successful path calls Application.Exit()), but the cancelled-UAC-
    // prompt and failed-relaunch paths don't — dismiss explicitly first so
    // a declined/failed restart doesn't leave this dialog sitting open
    // over whatever ShowStatus/ShowToast feedback those paths show instead.
    private void OnRestartClick()
    {
        State.DismissElevationDialog();
        State.RestartAsAdmin();
    }
}
