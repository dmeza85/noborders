        public MainForm()
        {
            LoadConfig();
            InitializeComponent();
            RefreshMonitorLists();
            RefreshGamesList();
            RegisterGlobalHotkeys();
            ApplyTheme();
            
            try
            {
                WM_SHELLHOOKMESSAGE = RegisterWindowMessage("SHELLHOOK");
                RegisterShellHookWindow(this.Handle);
                WM_SHOWFIRSTINSTANCE = RegisterWindowMessage("WM_SHOWFIRSTINSTANCE_NOBORDERS");
            }
            catch { }

            ApplyToExistingWindows();

            _mouseClipTimer.Interval = 100;
            _mouseClipTimer.Tick += MouseClipTimer_Tick;
            _mouseClipTimer.Start();

            _enforcementTimer.Interval = 1000;
            _enforcementTimer.Tick += EnforcementTimer_Tick;
            _enforcementTimer.Start();
            
            this.Resize += MainForm_Resize;
            this.FormClosing += MainForm_FormClosing;
        }

        private void InitializeComponent()
        {
            this.Text = "NoBorders Configuration Manager";
            this.Size = new System.Drawing.Size(760, 520);
            this.FormBorderStyle = FormBorderStyle.FixedSingle;
            this.MaximizeBox = false;
            this.StartPosition = FormStartPosition.CenterScreen;

            _lbGames.Bounds = new System.Drawing.Rectangle(12, 12, 220, 340);
            _lbGames.DrawMode = DrawMode.OwnerDrawFixed;
            _lbGames.ItemHeight = 24;
            _lbGames.DrawItem += LbGames_DrawItem;
            _lbGames.SelectedIndexChanged += (s, e) => { if (_lbGames.SelectedIndex != -1) LbGames_SelectedIndexChanged(); };

            Button btnAddProcess = new() { Text = "Add Game (Running)", Bounds = new System.Drawing.Rectangle(12, 360, 220, 25) };
            btnAddProcess.Click += BtnAddProcess_Click;

            Button btnAddProcessBrowse = new() { Text = "Add Game (Browse...)", Bounds = new System.Drawing.Rectangle(12, 390, 220, 25) };
            btnAddProcessBrowse.Click += BtnAddProcessBrowse_Click;

            _btnGear.Text = "⚙";
            _btnGear.Bounds = new System.Drawing.Rectangle(12, 440, 25, 25);
            _btnGear.Click += (s, e) => { 
                _pnlSettings.Visible = !_pnlSettings.Visible; 
                if (_pnlSettings.Visible) {
                    RefreshSettingsMonitors();
                    _pnlSettings.BringToFront(); 
                }
            };
            this.Controls.Add(_btnGear);

            int labelX = 250, inputX = 400, fullW = 290, numW = 250, btnW = 35, btnX = 655;

            CreateLabel("Game Name:", labelX, 15, 140, this.Controls);
            _txtGameName.Bounds = new System.Drawing.Rectangle(inputX, 12, fullW, 23);
            CreateLabel("Regex:", labelX, 45, 140, this.Controls);
            _txtRegex.Bounds = new System.Drawing.Rectangle(inputX, 42, fullW, 23);

            CreateLabel("If Display Profile Is:", labelX, 75, 140, this.Controls);
            _cmbPrimaryScope.Bounds = new System.Drawing.Rectangle(inputX, 72, fullW, 23);
            _cmbPrimaryScope.DropDownStyle = ComboBoxStyle.DropDownList;
            _cmbPrimaryScope.DrawMode = DrawMode.OwnerDrawFixed;
            _cmbPrimaryScope.DrawItem += ComboBox_DrawItem;
            _cmbPrimaryScope.SelectedIndexChanged += CmbPrimaryScope_SelectedIndexChanged;

            CreateLabel("Width:", labelX, 105, 140, this.Controls);
            ConfigureNumeric(_numWidth, inputX, 102, numW);
            ConfigureDefaultButton(_btnDefWidth, btnX, 102, btnW, () => ApplyDefaultValue(p => p.Width, _numWidth));

            CreateLabel("Height:", labelX, 135, 140, this.Controls);
            ConfigureNumeric(_numHeight, inputX, 132, numW);
            ConfigureDefaultButton(_btnDefHeight, btnX, 132, btnW, () => ApplyDefaultValue(p => p.Height, _numHeight));

            CreateLabel("Offset X:", labelX, 165, 140, this.Controls);
            ConfigureNumeric(_numOffsetX, inputX, 162, numW, -16384, 16384);
            ConfigureDefaultButton(_btnDefOffsetX, btnX, 162, btnW, () => ApplyDefaultValue(p => p.OffsetX, _numOffsetX));

            CreateLabel("Offset Y:", labelX, 195, 140, this.Controls);
            ConfigureNumeric(_numOffsetY, inputX, 192, numW, -16384, 16384);
            ConfigureDefaultButton(_btnDefOffsetY, btnX, 192, btnW, () => ApplyDefaultValue(p => p.OffsetY, _numOffsetY));

            _chkConstrainMouse.Text = "Lock Mouse to Window Bounds";
            _chkConstrainMouse.Bounds = new System.Drawing.Rectangle(inputX, 225, fullW, 23);

            Button btnLoadDefault = new() { Text = "Load Display Default", Bounds = new System.Drawing.Rectangle(labelX, 255, 440, 25) };
            btnLoadDefault.Click += BtnLoadDefault_Click;

            _btnEnable.Text = "Make Borderless";
            _btnEnable.Bounds = new System.Drawing.Rectangle(labelX, 290, 215, 25);
            _btnEnable.Click += (s, e) => ToggleState(true);
            _btnDisable.Text = "Undo Borderless";
            _btnDisable.Bounds = new System.Drawing.Rectangle(475, 290, 215, 25);
            _btnDisable.Click += (s, e) => ToggleState(false);

            Button btnDelete = new() { Text = "Remove Profile", Bounds = new System.Drawing.Rectangle(labelX, 440, 130, 25) };
            btnDelete.Click += BtnDelete_Click;
            Button btnSave = new() { Text = "Save Changes", Bounds = new System.Drawing.Rectangle(430, 440, 260, 25) };
            btnSave.Click += BtnSave_Click;

            SetupSettingsPanel();

            this.Controls.AddRange(new Control[] { 
                _lbGames, btnAddProcess, btnAddProcessBrowse, _txtGameName, _txtRegex, _cmbPrimaryScope, 
                _numWidth, _numHeight, _numOffsetX, _numOffsetY, 
                _btnDefWidth, _btnDefHeight, _btnDefOffsetX, _btnDefOffsetY,
                _chkConstrainMouse, btnLoadDefault, _btnEnable, _btnDisable, btnDelete, btnSave 
            });
            UpdateButtonStates();
        }

        private void SetupSettingsPanel()
        {
            _pnlSettings.Bounds = new System.Drawing.Rectangle(240, 12, 480, 460);
            _pnlSettings.Visible = false;

            int lblX = 15, inpX = 180, w = 260;
            
            int currentY = 15;
            Label titleDefaults = new() { Text = "Monitor Baseline Defaults", Bounds = new System.Drawing.Rectangle(lblX, currentY, 350, 20), Font = new System.Drawing.Font(this.Font, FontStyle.Bold) };
            _pnlSettings.Controls.Add(titleDefaults);

            CreateLabel("Monitor:", lblX, currentY + 30, 140, _pnlSettings.Controls);
            _cmbSettingsMonitor.Bounds = new System.Drawing.Rectangle(inpX, currentY + 27, w, 23);
            _cmbSettingsMonitor.DropDownStyle = ComboBoxStyle.DropDownList;
            _cmbSettingsMonitor.DrawMode = DrawMode.OwnerDrawFixed;
            _cmbSettingsMonitor.DrawItem += ComboBox_DrawItem;
            _cmbSettingsMonitor.SelectedIndexChanged += CmbSettingsMonitor_SelectedIndexChanged;
            _pnlSettings.Controls.Add(_cmbSettingsMonitor);

            CreateLabel("Width / Height:", lblX, currentY + 60, 140, _pnlSettings.Controls);
            ConfigureNumeric(_numSetWidth, inpX, currentY + 57, 125);
            ConfigureNumeric(_numSetHeight, inpX + 135, currentY + 57, 125);
            _pnlSettings.Controls.Add(_numSetWidth);
            _pnlSettings.Controls.Add(_numSetHeight);

            CreateLabel("Offset X / Y:", lblX, currentY + 90, 140, _pnlSettings.Controls);
            ConfigureNumeric(_numSetOffsetX, inpX, currentY + 87, 125, -16384, 16384);
            ConfigureNumeric(_numSetOffsetY, inpX + 135, currentY + 87, 125, -16384, 16384);
            _pnlSettings.Controls.Add(_numSetOffsetX);
            _pnlSettings.Controls.Add(_numSetOffsetY);

            _chkSetConstrain.Text = "Lock Mouse to Bounds";
            _chkSetConstrain.Bounds = new System.Drawing.Rectangle(inpX, currentY + 115, w, 23);
            _pnlSettings.Controls.Add(_chkSetConstrain);

            Button btnSaveSetDef = new() { Text = "Save Monitor Default", Bounds = new System.Drawing.Rectangle(inpX, currentY + 140, w, 25) };
            btnSaveSetDef.Click += BtnSaveSetDef_Click;
            _pnlSettings.Controls.Add(btnSaveSetDef);

            currentY = 195;
            Label titleHotkeys = new() { Text = "Global Hotkeys (Click box and press keys)", Bounds = new System.Drawing.Rectangle(lblX, currentY, 350, 20), Font = new System.Drawing.Font(this.Font, FontStyle.Bold) };
            _pnlSettings.Controls.Add(titleHotkeys);

            CreateLabel("Add Active App:", lblX, currentY + 30, 140, _pnlSettings.Controls);
            _txtHotkeyAdd.Bounds = new System.Drawing.Rectangle(inpX, currentY + 27, w, 23);
            _txtHotkeyAdd.ReadOnly = true;
            _txtHotkeyAdd.Text = _settings.HotkeyAddApp.ToString();
            _txtHotkeyAdd.KeyDown += (s, e) => CaptureHotkey(e, _settings.HotkeyAddApp, _txtHotkeyAdd);
            _pnlSettings.Controls.Add(_txtHotkeyAdd);

            CreateLabel("Refresh App Display:", lblX, currentY + 60, 140, _pnlSettings.Controls);
            _txtHotkeyRefresh.Bounds = new System.Drawing.Rectangle(inpX, currentY + 57, w, 23);
            _txtHotkeyRefresh.ReadOnly = true;
            _txtHotkeyRefresh.Text = _settings.HotkeyRefreshApp.ToString();
            _txtHotkeyRefresh.KeyDown += (s, e) => CaptureHotkey(e, _settings.HotkeyRefreshApp, _txtHotkeyRefresh);
            _pnlSettings.Controls.Add(_txtHotkeyRefresh);

            currentY = 295;
            Label titleOptions = new() { Text = "Application Options & Themes", Bounds = new System.Drawing.Rectangle(lblX, currentY, 350, 20), Font = new System.Drawing.Font(this.Font, FontStyle.Bold) };
            _pnlSettings.Controls.Add(titleOptions);

            _chkMinToTray.Text = "Minimize to Tray";
            _chkMinToTray.Bounds = new System.Drawing.Rectangle(lblX, currentY + 25, 210, 23);
            _chkMinToTray.Checked = _settings.MinimizeToTray;
            _chkMinToTray.CheckedChanged += (s, e) => { 
                _settings.MinimizeToTray = _chkMinToTray.Checked; 
                SaveConfigToDisk(); 
                if (((CheckBox)s!).Focused) ShowAlert("Setting Changed", $"Minimize to Tray set to {_settings.MinimizeToTray}");
            };
            _pnlSettings.Controls.Add(_chkMinToTray);

            _chkStartWithWindows.Text = "Start with Windows";
            _chkStartWithWindows.Bounds = new System.Drawing.Rectangle(lblX, currentY + 47, 210, 23);
            _chkStartWithWindows.Checked = _settings.StartWithWindows;
            _chkStartWithWindows.CheckedChanged += (s, e) => { 
                ToggleStartWithWindows(_chkStartWithWindows.Checked);
                _chkStartMinimized.Enabled = _chkStartWithWindows.Checked;
                if (!_chkStartWithWindows.Checked) _chkStartMinimized.Checked = false;
                if (((CheckBox)s!).Focused) ShowAlert("Setting Changed", $"Start with Windows set to {_settings.StartWithWindows}");
            };
            _pnlSettings.Controls.Add(_chkStartWithWindows);

            _chkStartMinimized.Text = "Start minimized";
            _chkStartMinimized.Bounds = new System.Drawing.Rectangle(lblX + 15, currentY + 69, 195, 23);
            _chkStartMinimized.Checked = _settings.StartMinimized;
            _chkStartMinimized.Enabled = _settings.StartWithWindows;
            _chkStartMinimized.CheckedChanged += (s, e) => { 
                _settings.StartMinimized = _chkStartMinimized.Checked; 
                SaveConfigToDisk(); 
                UpdateRegistryArgs(); 
                if (((CheckBox)s!).Focused) ShowAlert("Setting Changed", $"Start Minimized set to {_settings.StartMinimized}");
            };
            _pnlSettings.Controls.Add(_chkStartMinimized);

            int col2X = 240;
            CreateLabel("Color Mode:", col2X, currentY + 25, 145, _pnlSettings.Controls);
            _cmbThemeMode.Bounds = new System.Drawing.Rectangle(col2X + 85, currentY + 25, 130, 23);
            _cmbThemeMode.DropDownStyle = ComboBoxStyle.DropDownList;
            _cmbThemeMode.DrawMode = DrawMode.OwnerDrawFixed;
            _cmbThemeMode.DrawItem += ComboBox_DrawItem;
            _cmbThemeMode.Items.AddRange(new object[] { "Light", "Dark", "Follow System" });
            _cmbThemeMode.SelectedIndex = (int)_settings.ColorMode;
            _cmbThemeMode.SelectedIndexChanged += (s, e) => {
                _settings.ColorMode = (ThemeMode)_cmbThemeMode.SelectedIndex;
                SaveConfigToDisk();
                ApplyTheme();
                if (((ComboBox)s!).Focused) ShowAlert("Setting Changed", $"Color Mode set to {_settings.ColorMode}");
            };
            _pnlSettings.Controls.Add(_cmbThemeMode);

            Button btnClose = new() { Text = "Close Settings", Bounds = new System.Drawing.Rectangle(inpX, 420, w, 25) };
            btnClose.Click += (s, e) => _pnlSettings.Visible = false;
            _pnlSettings.Controls.Add(btnClose);

            this.Controls.Add(_pnlSettings);
        }

        private void ShowAlert(string title, string message)
        {
            SystemSounds.Asterisk.Play();
            MessageBox.Show(message, $"NoBorders - {title}", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void ApplyTheme()
        {
            bool isDark = false;
            if (_settings.ColorMode == ThemeMode.Dark) isDark = true;
            else if (_settings.ColorMode == ThemeMode.FollowSystem) isDark = GetSystemThemeIsDark();

            this.BackColor = isDark ? Color.FromArgb(32, 32, 32) : SystemColors.Control;
            _pnlSettings.BackColor = isDark ? Color.FromArgb(36, 36, 36) : SystemColors.Control;
            _pnlSettings.BorderStyle = isDark ? BorderStyle.FixedSingle : BorderStyle.Fixed3D;

            ApplyThemeToControls(this.Controls, isDark);

            _lbGames.Invalidate();
            _cmbPrimaryScope.Invalidate();
            _cmbSettingsMonitor.Invalidate();
            _cmbThemeMode.Invalidate();
        }

        private void ApplyThemeToControls(Control.ControlCollection controls, bool isDark)
        {
            Color fg = isDark ? Color.White : SystemColors.ControlText;
            Color controlBg = isDark ? Color.FromArgb(45, 45, 45) : SystemColors.Window;
            Color btnBg = isDark ? Color.FromArgb(55, 55, 55) : SystemColors.Control;
            Color borderCol = isDark ? Color.DimGray : SystemColors.ControlDark;

            foreach (Control ctrl in controls)
            {
                if (ctrl is Panel pnl) 
                {
                    ApplyThemeToControls(pnl.Controls, isDark);
                }
                else if (ctrl is Label lbl) 
                {
                    lbl.ForeColor = fg;
                }
                else if (ctrl is CheckBox chk) 
                {
                    chk.ForeColor = fg;
                }
                else if (ctrl is TextBox txt) 
                {
                    txt.BackColor = controlBg; 
                    txt.ForeColor = fg;
                    txt.BorderStyle = isDark ? BorderStyle.FixedSingle : BorderStyle.Fixed3D;
                }
                else if (ctrl is NumericUpDown num) 
                {
                    num.BackColor = controlBg; 
                    num.ForeColor = fg;
                    num.BorderStyle = isDark ? BorderStyle.FixedSingle : BorderStyle.Fixed3D;
                }
                else if (ctrl is ComboBox cmb) 
                {
                    cmb.BackColor = controlBg; 
                    cmb.ForeColor = fg;
                    cmb.FlatStyle = isDark ? FlatStyle.Flat : FlatStyle.Standard;
                }
                else if (ctrl is ListBox lst) 
                {
                    lst.BackColor = controlBg; 
                    lst.ForeColor = fg;
                }
                else if (ctrl is Button btn) 
                {
                    btn.BackColor = btnBg;
                    btn.ForeColor = fg;
                    btn.FlatStyle = isDark ? FlatStyle.Flat : FlatStyle.Standard;
                    if (isDark) 
                    {
                        btn.FlatAppearance.BorderColor = borderCol;
                        btn.FlatAppearance.BorderSize = 1;
                    }
                }
            }
        }

        private bool GetSystemThemeIsDark()
        {
            try
            {
                using RegistryKey? key = Registry.CurrentUser.OpenSubKey(REG_THEME_KEY);
                if (key != null)
                {
                    object? val = key.GetValue("AppsUseLightTheme");
                    if (val is int intVal) return intVal == 0;
                }
            }
            catch { }
            return false;
        }

        private void ComboBox_DrawItem(object? sender, DrawItemEventArgs e)
        {
            if (e.Index < 0 || sender is not ComboBox combo) return;

            bool isDark = false;
            if (_settings.ColorMode == ThemeMode.Dark) isDark = true;
            else if (_settings.ColorMode == ThemeMode.FollowSystem) isDark = GetSystemThemeIsDark();

            Color bg = isDark ? Color.FromArgb(45, 45, 45) : SystemColors.Window;
            Color fg = isDark ? Color.White : SystemColors.ControlText;

            if ((e.State & DrawItemState.Selected) == DrawItemState.Selected)
            {
                bg = isDark ? Color.DimGray : SystemColors.Highlight;
                fg = isDark ? Color.White : SystemColors.HighlightText;
            }

            e.DrawBackground();
            using Brush bgBrush = new SolidBrush(bg);
            e.Graphics.FillRectangle(bgBrush, e.Bounds);

            using Brush fgBrush = new SolidBrush(fg);
            string itemText = combo.Items[e.Index].ToString() ?? string.Empty;
            
            TextRenderer.DrawText(e.Graphics, itemText, combo.Font, e.Bounds, fg, TextFormatFlags.Left | TextFormatFlags.VerticalCenter);
        }

        private void RefreshSettingsMonitors()
        {
            string current = _cmbSettingsMonitor.SelectedItem?.ToString() ?? string.Empty;
            _cmbSettingsMonitor.Items.Clear();
            _cmbSettingsMonitor.Items.AddRange(_settings.KnownMonitors.ToArray());
            if (_cmbSettingsMonitor.Items.Count > 0)
            {
                if (!string.IsNullOrEmpty(current) && _cmbSettingsMonitor.Items.Contains(current)) _cmbSettingsMonitor.SelectedItem = current;
                else _cmbSettingsMonitor.SelectedIndex = 0;
            }
        }

        private void CmbSettingsMonitor_SelectedIndexChanged(object? sender, EventArgs e)
        {
            string sel = _cmbSettingsMonitor.SelectedItem?.ToString() ?? string.Empty;
            if (string.IsNullOrEmpty(sel)) return;

            if (_settings.MonitorDefaults.TryGetValue(sel, out var def))
            {
                _numSetWidth.Value = def.Width;
                _numSetHeight.Value = def.Height;
                _numSetOffsetX.Value = def.OffsetX;
                _numSetOffsetY.Value = def.OffsetY;
                _chkSetConstrain.Checked = def.ConstrainMouse;
            }
            else
            {
                _numSetWidth.Value = 1920;
                _numSetHeight.Value = 1080;
                _numSetOffsetX.Value = 0;
                _numSetOffsetY.Value = 0;
                _chkSetConstrain.Checked = false;
            }
        }

        private void BtnSaveSetDef_Click(object? sender, EventArgs e)
        {
            string sel = _cmbSettingsMonitor.SelectedItem?.ToString() ?? string.Empty;
            if (string.IsNullOrEmpty(sel)) return;

            _settings.MonitorDefaults[sel] = new GameDisplayProfile
            {
                Width = (int)_numSetWidth.Value,
                Height = (int)_numSetHeight.Value,
                OffsetX = (int)_numSetOffsetX.Value,
                OffsetY = (int)_numSetOffsetY.Value,
                ConstrainMouse = _chkSetConstrain.Checked
            };
            SaveConfigToDisk();
            ShowAlert("Setting Changed", $"Monitor defaults saved for display:\n{sel}");
            
            Button? btn = sender as Button;
            if (btn != null)
            {
                string originalText = btn.Text;
                btn.Text = "Saved!";
                System.Windows.Forms.Timer t = new() { Interval = 1500 };
                t.Tick += (ts, te) => { btn.Text = originalText; t.Stop(); t.Dispose(); };
                t.Start();
            }
        }

        private void CaptureHotkey(KeyEventArgs e, HotkeyConfig config, TextBox txt)
        {
            e.SuppressKeyPress = true;
            if (e.KeyCode == Keys.ShiftKey || e.KeyCode == Keys.ControlKey || e.KeyCode == Keys.Menu) return;
            if (e.KeyCode == Keys.Escape || e.KeyCode == Keys.Back || e.KeyCode == Keys.Delete)
            {
                config.Modifiers = 0; config.Key = 0;
            }
            else
            {
                uint mods = 0;
                if (e.Control) mods |= MOD_CONTROL;
                if (e.Shift) mods |= MOD_SHIFT;
                if (e.Alt) mods |= MOD_ALT;
                config.Modifiers = mods;
                config.Key = (uint)e.KeyCode;
            }
            txt.Text = config.ToString();
            SaveConfigToDisk();
            RegisterGlobalHotkeys();
            ShowAlert("Setting Changed", $"Global hotkey successfully updated to:\n{config.ToString()}");
        }

        private void RegisterGlobalHotkeys()
        {
            UnregisterHotKey(this.Handle, HOTKEY_ID_ADD);
            UnregisterHotKey(this.Handle, HOTKEY_ID_REFRESH);
            
            if (_settings.HotkeyAddApp.Key != 0) RegisterHotKey(this.Handle, HOTKEY_ID_ADD, _settings.HotkeyAddApp.Modifiers, _settings.HotkeyAddApp.Key);
            if (_settings.HotkeyRefreshApp.Key != 0) RegisterHotKey(this.Handle, HOTKEY_ID_REFRESH, _settings.HotkeyRefreshApp.Modifiers, _settings.HotkeyRefreshApp.Key);
        }

        private string CleanUnmanagedString(string input)
        {
            if (string.IsNullOrEmpty(input)) return string.Empty;
            int nullIdx = input.IndexOf('\0');
            return nullIdx >= 0 ? input.Substring(0, nullIdx).Trim() : input.Trim();
        }

        private Dictionary<string, string> GetGdiToFriendlyMap()
        {
            var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            try
            {
                uint numPathElements, numModeElements;
                if (GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, out numPathElements, out numModeElements) != 0) return map;

                var paths = new DISPLAYCONFIG_PATH_INFO[numPathElements];
                var modes = new DISPLAYCONFIG_MODE_INFO[numModeElements];

                if (QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, ref numPathElements, paths, ref numModeElements, modes, IntPtr.Zero) != 0) return map;

                for (int i = 0; i < numPathElements; i++)
                {
                    var sourceName = new DISPLAYCONFIG_SOURCE_DEVICE_NAME { header = { type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME, size = (uint)Marshal.SizeOf(typeof(DISPLAYCONFIG_SOURCE_DEVICE_NAME)), adapterId = paths[i].sourceInfo.adapterId, id = paths[i].sourceInfo.id } };
                    int srcError = DisplayConfigGetDeviceInfo(ref sourceName);

                    var targetName = new DISPLAYCONFIG_TARGET_DEVICE_NAME { header = { type = DISPLAYCONFIG_DEVICE_INFO_GET_TARGET_NAME, size = (uint)Marshal.SizeOf(typeof(DISPLAYCONFIG_TARGET_DEVICE_NAME)), adapterId = paths[i].targetInfo.adapterId, id = paths[i].targetInfo.id } };
                    int tgtError = DisplayConfigGetDeviceInfo(ref targetName);

                    if (srcError == 0 && tgtError == 0)
                    {
                        string gdiName = CleanUnmanagedString(sourceName.viewGdiDeviceName);
                        string friendlyName = CleanUnmanagedString(targetName.monitorFriendlyDeviceName);

                        if (string.IsNullOrEmpty(friendlyName)) friendlyName = $"Monitor_{targetName.edidManufactureId:X4}_{targetName.edidProductCodeId:X4}";
                        if (!string.IsNullOrEmpty(gdiName)) map[gdiName] = friendlyName;
                    }
                }
            }
            catch { }
            return map;
        }

        private void RefreshMonitorLists() 
        { 
            try
            {
                _cachedMonitors.Clear();
                var gdiToFriendlyMap = GetGdiToFriendlyMap();
                var duplicates = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

                foreach (var screen in Screen.AllScreens)
                {
                    string cleanedGdiName = CleanUnmanagedString(screen.DeviceName);
                    if (!gdiToFriendlyMap.TryGetValue(cleanedGdiName, out string? friendly) || string.IsNullOrWhiteSpace(friendly)) friendly = cleanedGdiName;
                    
                    if (duplicates.ContainsKey(friendly)) { duplicates[friendly]++; friendly = $"{friendly} ({duplicates[friendly]})"; }
                    else duplicates[friendly] = 1;

                    _cachedMonitors.Add(new MonitorItem { ID = friendly, DeviceName = screen.DeviceName });
                    if (!IsIgnoredMonitorName(friendly)) _settings.KnownMonitors.Add(friendly);
                }
                UpdateMonitorComboBoxes();
            }
            catch { }
        }

        private bool IsIgnoredMonitorName(string name)
        {
            if (string.IsNullOrWhiteSpace(name)) return true;
            if (name.StartsWith(@"\\.\DISPLAY", StringComparison.OrdinalIgnoreCase)) return true;
            if (name.StartsWith("Generic PnP", StringComparison.OrdinalIgnoreCase)) return true;
            if (name.StartsWith("Generic Non-PnP", StringComparison.OrdinalIgnoreCase)) return true;
            return false;
        }

        private void UpdateMonitorComboBoxes()
        {
            _isUpdatingUI = true;
            _settings.KnownMonitors.RemoveWhere(IsIgnoredMonitorName);
            
            var allMonitors = new List<string>();
            allMonitors.AddRange(_cachedMonitors.Select(m => m.ID));
            foreach (var known in _settings.KnownMonitors) 
                if (!allMonitors.Contains(known, StringComparer.OrdinalIgnoreCase)) 
                    allMonitors.Add(known);

            SyncComboBox(_cmbPrimaryScope, allMonitors, ref _lastSelectedScope);
            _isUpdatingUI = false;
        }

        private void SyncComboBox(ComboBox cmb, List<string> items, ref string lastScope)
        {
            string? current = cmb.SelectedItem?.ToString() ?? lastScope;
            cmb.Items.Clear();
            cmb.Items.AddRange(items.ToArray());
            
            if (cmb.Items.Count > 0)
            {
                if (current != null && cmb.Items.Contains(current)) cmb.SelectedItem = current;
                else cmb.SelectedIndex = 0;
            }
            
            lastScope = cmb.SelectedItem?.ToString() ?? string.Empty;
        }

        private string GetPrimaryMonitorID()
        {
            var primary = Screen.PrimaryScreen;
            if (primary == null) return string.Empty;
            string cleanedPrimaryGdi = CleanUnmanagedString(primary.DeviceName);
            var match = _cachedMonitors.FirstOrDefault(m => CleanUnmanagedString(m.DeviceName).Equals(cleanedPrimaryGdi, StringComparison.OrdinalIgnoreCase));
            return match != null ? match.ID : string.Empty;
        }

        private void SetupTrayIcon()
        {
            ToolStripMenuItem menuOpen = new("Open Manager");
            menuOpen.Click += (s, e) => ShowFormFromTray();
            ToolStripMenuItem menuExit = new("Exit Application");
            menuExit.Click += (s, e) => { _forceClose = true; Application.Exit(); };
            _trayMenu.Items.AddRange(new ToolStripItem[] { menuOpen, menuExit });
            _trayIcon.Text = "NoBorders Manager";
            try { _trayIcon.Icon = Icon.ExtractAssociatedIcon(Application.ExecutablePath) ?? SystemIcons.Application; } catch { _trayIcon.Icon = SystemIcons.Application; }
            _trayIcon.ContextMenuStrip = _trayMenu;
            
            _trayIcon.MouseDoubleClick += (s, e) => { if (e.Button == MouseButtons.Left) ShowFormFromTray(); };
            _trayIcon.Visible = true;
            
            string[] args = Environment.GetCommandLineArgs();
            if (args.Contains("-minimized", StringComparer.OrdinalIgnoreCase))
            {
                this.WindowState = FormWindowState.Minimized;
                this.ShowInTaskbar = false;
                BeginInvoke(new MethodInvoker(() => { this.Hide(); }));
            }
        }

        private void ShowFormFromTray() 
        { 
            this.Show(); 
            this.ShowInTaskbar = true;
            this.WindowState = FormWindowState.Normal; 
            this.BringToFront(); 
            this.Activate(); 
            SetForegroundWindow(this.Handle);
        }

        private void CreateLabel(string t, int x, int y, int w, Control.ControlCollection owner) 
        {
            Label lbl = new() { Text = t, Bounds = new System.Drawing.Rectangle(x, y, w, 20), TextAlign = ContentAlignment.MiddleLeft };
            owner.Add(lbl);
        }

        private void ConfigureNumeric(NumericUpDown n, int x, int y, int w, int min = 0, int max = 16384) { n.Bounds = new System.Drawing.Rectangle(x, y, w, 23); n.Minimum = min; n.Maximum = max; }
        private void ConfigureDefaultButton(Button b, int x, int y, int w, Action onClick) { b.Text = "↶"; b.Bounds = new System.Drawing.Rectangle(x, y, w, 23); b.Click += (s, e) => onClick(); }

        private void LoadConfig()
        {
            try
            {
                if (File.Exists(_configPath))
                {
                    _settings = JsonSerializer.Deserialize<AppSettings>(File.ReadAllText(_configPath)) ?? new();
                    if (_settings.MonitorDefaults == null) _settings.MonitorDefaults = new(StringComparer.OrdinalIgnoreCase);
                    
                    foreach (var g in _settings.Games) 
                    { 
                        if (g.Profiles == null) g.Profiles = new(StringComparer.OrdinalIgnoreCase); 
                        foreach (var key in g.Profiles.Keys) 
                            if (!IsIgnoredMonitorName(key)) _settings.KnownMonitors.Add(key); 
                    }
                    if (_settings.HotkeyAddApp == null) _settings.HotkeyAddApp = new() { Modifiers = 6, Key = (uint)Keys.A };
                    if (_settings.HotkeyRefreshApp == null) _settings.HotkeyRefreshApp = new() { Modifiers = 6, Key = (uint)Keys.R };
                }
            }
            catch { _settings = new AppSettings(); }
        }

        private void SaveConfigToDisk() { try { File.WriteAllText(_configPath, JsonSerializer.Serialize(_settings, new JsonSerializerOptions { WriteIndented = true })); } catch { } }
        
        private void RefreshGamesList()
        {
            _lbGames.Items.Clear();
            foreach (var g in _settings.Games) { _lbGames.Items.Add(g); CacheExeIcon(g.ExePath); }
            _selectedGame = null;
            UpdateButtonStates();
        }

        private void CacheExeIcon(string path) { if (string.IsNullOrEmpty(path) || _iconCache.ContainsKey(path) || !File.Exists(path)) return; try { using Icon? ico = Icon.ExtractAssociatedIcon(path); if (ico != null) _iconCache[path] = ico.ToBitmap(); } catch { } }
        
        private void UpdateButtonStates() 
        { 
            bool hasGame = _selectedGame != null;
            _btnEnable.Enabled = hasGame && !_selectedGame!.IsActive; 
            _btnDisable.Enabled = hasGame && _selectedGame!.IsActive; 
            _btnDefWidth.Enabled = hasGame; _btnDefHeight.Enabled = hasGame; _btnDefOffsetX.Enabled = hasGame; _btnDefOffsetY.Enabled = hasGame;
        }

        private void LbGames_SelectedIndexChanged()
        {
            _isUpdatingUI = true;
            _selectedGame = _settings.Games[_lbGames.SelectedIndex];
            _txtGameName.Text = _selectedGame.GameName;
            _txtRegex.Text = _selectedGame.RegexPattern;
            
            string currentPrimary = GetPrimaryMonitorID();
            if (!string.IsNullOrEmpty(currentPrimary) && _cmbPrimaryScope.Items.Contains(currentPrimary)) 
                _cmbPrimaryScope.SelectedItem = currentPrimary; 
            else if (_cmbPrimaryScope.Items.Count > 0) 
                _cmbPrimaryScope.SelectedIndex = 0;
            
            _lastSelectedScope = _cmbPrimaryScope.SelectedItem?.ToString() ?? string.Empty;
            LoadGameProfileDataToUI(_selectedGame, _lastSelectedScope);
            UpdateButtonStates();
            _isUpdatingUI = false;
        }

        private void CmbPrimaryScope_SelectedIndexChanged(object? sender, EventArgs e) 
        { 
            if (_isUpdatingUI || _selectedGame == null) return; 
            SaveGameUIToProfile(_lastSelectedScope); 
            _lastSelectedScope = _cmbPrimaryScope.SelectedItem?.ToString() ?? string.Empty; 
            LoadGameProfileDataToUI(_selectedGame, _lastSelectedScope); 
        }

        private void LoadGameProfileDataToUI(GameConfig g, string scope) 
        { 
            if (string.IsNullOrEmpty(scope)) return;
            GameDisplayProfile p = GetEffectiveProfile(g, scope); 
            _numWidth.Value = p.Width; 
            _numHeight.Value = p.Height; 
            _numOffsetX.Value = p.OffsetX; 
            _numOffsetY.Value = p.OffsetY; 
            _chkConstrainMouse.Checked = p.ConstrainMouse; 
        }

        private GameDisplayProfile GetEffectiveProfile(GameConfig? g, string scope) 
        { 
            if (g != null && g.Profiles.TryGetValue(scope, out var gp)) return gp; 
            if (_settings.MonitorDefaults.TryGetValue(scope, out var defaultProfile))
            {
                return new GameDisplayProfile
                {
                    Width = defaultProfile.Width,
                    Height = defaultProfile.Height,
                    OffsetX = defaultProfile.OffsetX,
                    OffsetY = defaultProfile.OffsetY,
                    ConstrainMouse = defaultProfile.ConstrainMouse
                };
            }
            return new GameDisplayProfile { Width = 1920, Height = 1080 }; 
        }

        private void SaveGameUIToProfile(string scope) 
        { 
            if (_selectedGame == null || string.IsNullOrEmpty(scope)) return; 
            if (!_selectedGame.Profiles.ContainsKey(scope)) _selectedGame.Profiles[scope] = new GameDisplayProfile(); 
            var p = _selectedGame.Profiles[scope]; 
            p.Width = (int)_numWidth.Value; 
            p.Height = (int)_numHeight.Value; 
            p.OffsetX = (int)_numOffsetX.Value; 
            p.OffsetY = (int)_numOffsetY.Value; 
            p.ConstrainMouse = _chkConstrainMouse.Checked; 
            if (!IsIgnoredMonitorName(scope)) _settings.KnownMonitors.Add(scope); 
        }

        private void BtnLoadDefault_Click(object? sender, EventArgs e)
        {
            if (string.IsNullOrEmpty(_lastSelectedScope)) return;
            if (_settings.MonitorDefaults.TryGetValue(_lastSelectedScope, out var def))
            {
                _numWidth.Value = def.Width;
                _numHeight.Value = def.Height;
                _numOffsetX.Value = def.OffsetX;
                _numOffsetY.Value = def.OffsetY;
                _chkConstrainMouse.Checked = def.ConstrainMouse;
            }
        }

        private void ApplyDefaultValue(Func<GameDisplayProfile, int> selector, NumericUpDown target)
        {
            if (_selectedGame == null) return;
            GameDisplayProfile defProfile = _settings.MonitorDefaults.TryGetValue(_lastSelectedScope, out var dp) ? dp : new GameDisplayProfile();
            target.Value = selector(defProfile);
            SaveGameUIToProfile(_lastSelectedScope);
        }

        private void LbGames_DrawItem(object? sender, DrawItemEventArgs e)
        {
            if (e.Index < 0 || e.Index >= _settings.Games.Count) return;
            e.DrawBackground(); Graphics g = e.Graphics; GameConfig config = _settings.Games[e.Index];
            string statusSymbol = config.IsActive ? "✔" : "✘"; 
            
            bool isDark = false;
            if (_settings.ColorMode == ThemeMode.Dark) isDark = true;
            else if (_settings.ColorMode == ThemeMode.FollowSystem) isDark = GetSystemThemeIsDark();

            Brush statusBrush = config.IsActive ? Brushes.Green : Brushes.Red;
            if ((e.State & DrawItemState.Selected) == DrawItemState.Selected) statusBrush = SystemBrushes.HighlightText;
            g.DrawString(statusSymbol, new Font(e.Font ?? this.Font, FontStyle.Bold), statusBrush, e.Bounds.X + 5, e.Bounds.Y + 4);
            int iconX = e.Bounds.X + 28;
            if (!string.IsNullOrEmpty(config.ExePath) && _iconCache.TryGetValue(config.ExePath, out Image? img)) g.DrawImage(img, iconX, e.Bounds.Y + 4, 16, 16); else g.DrawIcon(SystemIcons.Application, new Rectangle(iconX, e.Bounds.Y + 4, 16, 16));
            
            Brush textBrush;
            if ((e.State & DrawItemState.Selected) == DrawItemState.Selected) textBrush = SystemBrushes.HighlightText;
            else textBrush = isDark ? Brushes.White : SystemBrushes.ControlText;
            
            g.DrawString(config.GameName, e.Font ?? this.Font, textBrush, e.Bounds.X + 50, e.Bounds.Y + 4);
            e.DrawFocusRectangle();
        }

        private void ToggleState(bool active) { if (_selectedGame == null) return; _selectedGame.IsActive = active; SaveConfigToDisk(); int index = _lbGames.SelectedIndex; RefreshGamesList(); _lbGames.SelectedIndex = index; EnforceState(_selectedGame); }
        private void EnforceState(GameConfig g) { foreach (Process p in Process.GetProcesses()) { try { if (p.MainWindowHandle != IntPtr.Zero && Regex.IsMatch(p.ProcessName + ".exe", g.RegexPattern)) ApplyWindowStyles(p.MainWindowHandle, g); } catch { continue; } } }

        private void BtnAddProcess_Click(object? sender, EventArgs e)
        {
            using Form f = new() { Text = "Select Running Process", Size = new System.Drawing.Size(300, 400), StartPosition = FormStartPosition.CenterParent, FormBorderStyle = FormBorderStyle.FixedDialog };
            ListBox lb = new() { Dock = DockStyle.Fill }; Button btn = new() { Text = "Select", Dock = DockStyle.Bottom, DialogResult = DialogResult.OK };
            lb.Items.AddRange(Process.GetProcesses().Where(p => !string.IsNullOrEmpty(p.MainWindowTitle)).Select(p => p.ProcessName + ".exe").Distinct().OrderBy(s => s).ToArray());
            f.Controls.AddRange(new Control[] { lb, btn }); f.AcceptButton = btn;
            if (f.ShowDialog() == DialogResult.OK && lb.SelectedIndex != -1) AddProcessByExeName(lb.SelectedItem?.ToString());
        }

        private void BtnAddProcessBrowse_Click(object? sender, EventArgs e)
        {
            using OpenFileDialog ofd = new() { Filter = "Executables (*.exe)|*.exe", Title = "Select Game Executable" };
            if (ofd.ShowDialog() == DialogResult.OK)
            {
                AddProcessByExeName(ofd.FileName, true);
            }
        }

        private void AddProcessByExeName(string? exeInput, bool isFullPath = false)
        {
            if (string.IsNullOrEmpty(exeInput)) return;
            
            string baseName = Path.GetFileNameWithoutExtension(exeInput);
            string sanitizedBase = Regex.Replace(baseName, @"(-d|-shipping|-win64|-test|-debug)$", "", RegexOptions.IgnoreCase);
            string pattern = $"^(?i){Regex.Escape(sanitizedBase)}.*\\.exe$";
            
            if (_settings.Games.Any(g => g.GameName.Equals(sanitizedBase, StringComparison.OrdinalIgnoreCase)))
            {
                ShowAlert("Info", $"{sanitizedBase} is already tracked by NoBorders.");
                return;
            }

            string discoveredPath = isFullPath ? exeInput : string.Empty;
            if (!isFullPath)
            {
                try { discoveredPath = Process.GetProcesses().FirstOrDefault(p => (p.ProcessName + ".exe").Equals(exeInput, StringComparison.OrdinalIgnoreCase))?.MainModule?.FileName ?? string.Empty; } catch { }
            }
            
            GameConfig g = new() { GameName = sanitizedBase, RegexPattern = pattern, ExePath = discoveredPath, IsActive = false };
            
            string primaryMon = GetPrimaryMonitorID();
            if (!string.IsNullOrEmpty(primaryMon) && _settings.MonitorDefaults.TryGetValue(primaryMon, out var defProfile))
            {
                g.Profiles[primaryMon] = new GameDisplayProfile
                {
                    Width = defProfile.Width,
                    Height = defProfile.Height,
                    OffsetX = defProfile.OffsetX,
                    OffsetY = defProfile.OffsetY,
                    ConstrainMouse = defProfile.ConstrainMouse
                };
            }

            _settings.Games.Add(g); 
            SaveConfigToDisk(); 
            RefreshGamesList(); 
            _lbGames.SelectedIndex = _lbGames.Items.Count - 1;

            ShowAlert("Application Added", $"{sanitizedBase} added successfully.\nApplied Monitor Defaults for: {(string.IsNullOrEmpty(primaryMon) ? "None" : primaryMon)}");
        }

        private void BtnSave_Click(object? sender, EventArgs e) { if (_selectedGame != null) { _selectedGame.GameName = _txtGameName.Text; _selectedGame.RegexPattern = _txtRegex.Text; SaveGameUIToProfile(_lastSelectedScope); SaveConfigToDisk(); if (_selectedGame.IsActive) EnforceState(_selectedGame); int index = _lbGames.SelectedIndex; RefreshGamesList(); _lbGames.SelectedIndex = index; } }
        private void BtnDelete_Click(object? sender, EventArgs e) { if (_selectedGame != null) { _settings.Games.Remove(_selectedGame); SaveConfigToDisk(); RefreshGamesList(); } }

        private void ToggleStartWithWindows(bool enable) 
        { 
            _settings.StartWithWindows = enable; 
            SaveConfigToDisk(); 
            UpdateRegistryArgs();
        }

        private void UpdateRegistryArgs()
        {
            try 
            { 
                using RegistryKey? key = Registry.CurrentUser.OpenSubKey(REG_RUN_KEY, true); 
                if (key != null) 
                { 
                    if (_settings.StartWithWindows) 
                    { 
                        string args = _settings.StartMinimized ? " -minimized" : string.Empty;
                        key.SetValue(APP_NAME, $"\"{Application.ExecutablePath}\"{args}"); 
                    } 
                    else 
                    { 
                        key.DeleteValue(APP_NAME, false); 
                    } 
                } 
            } 
            catch { } 
        }

        private void MainForm_Resize(object? sender, EventArgs e) 
        { 
            if (this.WindowState == FormWindowState.Minimized && _settings.MinimizeToTray) 
            {
                this.Hide(); 
                this.ShowInTaskbar = false;
            } 
        }
        
        private void MainForm_FormClosing(object? sender, FormClosingEventArgs e) { UnregisterHotKey(this.Handle, HOTKEY_ID_ADD); UnregisterHotKey(this.Handle, HOTKEY_ID_REFRESH); if (!_forceClose && e.CloseReason == CloseReason.UserClosing) { e.Cancel = true; this.WindowState = FormWindowState.Minimized; MainForm_Resize(this, EventArgs.Empty); } else _trayIcon.Dispose(); }

        private void ApplyToExistingWindows() { foreach (Process p in Process.GetProcesses()) { try { if (p.MainWindowHandle != IntPtr.Zero) ProcessWindow(p.MainWindowHandle, p); } catch { continue; } } }

        protected override void WndProc(ref Message m)
        {
            if (m.Msg == WM_SHELLHOOKMESSAGE && m.WParam.ToInt32() == HSHELL_WINDOWCREATED) ProcessWindowHandleAsync(m.LParam);
            if (m.Msg == WM_SHOWFIRSTINSTANCE && WM_SHOWFIRSTINSTANCE != 0) { ShowFormFromTray(); return; }
            if (m.Msg == WM_DISPLAYCHANGE) RefreshMonitorLists();
            if (m.Msg == WM_SETTINGCHANGE) { if (_settings.ColorMode == ThemeMode.FollowSystem) ApplyTheme(); }
            if (m.Msg == WM_HOTKEY)
            {
                if (m.WParam.ToInt32() == HOTKEY_ID_ADD) HandleHotkeyAddApp();
                else if (m.WParam.ToInt32() == HOTKEY_ID_REFRESH) HandleHotkeyRefreshApp();
            }
            base.WndProc(ref m);
        }

        private void HandleHotkeyAddApp()
        {
            IntPtr hwnd = GetForegroundWindow();
            if (hwnd == IntPtr.Zero) return;
            try
            {
                GetWindowThreadProcessId(hwnd, out uint pid);
                if (pid == 0) return;
                using Process p = Process.GetProcessById((int)pid);
                string exeName = p.ProcessName + ".exe";
                if (exeName.Equals("explorer.exe", StringComparison.OrdinalIgnoreCase)) return;
                if (string.Equals(p.MainModule?.FileName, Application.ExecutablePath, StringComparison.OrdinalIgnoreCase)) return;

                bool exists = _settings.Games.Any(g => Regex.IsMatch(exeName, g.RegexPattern));
                if (!exists)
                {
                    this.Invoke((MethodInvoker)delegate {
                        AddProcessByExeName(exeName);
                    });
                }
            }
            catch { }
        }

        private void HandleHotkeyRefreshApp()
        {
            IntPtr hwnd = GetForegroundWindow();
            if (hwnd == IntPtr.Zero) return;
            try
            {
                GetWindowThreadProcessId(hwnd, out uint pid);
                if (pid == 0) return;
                using Process p = Process.GetProcessById((int)pid);
                string exeName = (p.ProcessName + ".exe").ToLower();
                var match = _settings.Games.FirstOrDefault(g => g.IsActive && Regex.IsMatch(exeName, g.RegexPattern));
                if (match != null) ApplyWindowStyles(hwnd, match);
            }
            catch { }
        }

        private async void ProcessWindowHandleAsync(IntPtr hWnd)
        {
            for (int i = 0; i < 20; i++)
            {
                await System.Threading.Tasks.Task.Delay(100);
                try
                {
                    if (GetWindowThreadProcessId(hWnd, out uint pid) != 0 && pid != 0)
                    {
                        using Process p = Process.GetProcessById((int)pid);
                        string exe = (p.ProcessName + ".exe").ToLower();
                        foreach (var g in _settings.Games)
                        {
                            if (g.IsActive && Regex.IsMatch(exe, g.RegexPattern))
                            {
                                GetWindowRect(hWnd, out RECT r);
                                if ((r.Right - r.Left) > 100 && (r.Bottom - r.Top) > 100)
                                {
                                    ApplyWindowStyles(hWnd, g);
                                    return;
                                }
                            }
                        }
                    }
                }
                catch { }
            }
        }

        private void ProcessWindow(IntPtr hWnd, Process p) { string exe = (p.ProcessName + ".exe").ToLower(); foreach (var g in _settings.Games) { if (g.IsActive && Regex.IsMatch(exe, g.RegexPattern)) ApplyWindowStyles(hWnd, g); } }

        private void EnforcementTimer_Tick(object? sender, EventArgs e)
        {
            foreach (Process p in Process.GetProcesses())
            {
                try
                {
                    if (p.MainWindowHandle != IntPtr.Zero)
                    {
                        string exe = (p.ProcessName + ".exe").ToLower();
                        foreach (var g in _settings.Games)
                        {
                            if (g.IsActive && Regex.IsMatch(exe, g.RegexPattern))
                            {
                                ApplyWindowStyles(p.MainWindowHandle, g);
                            }
                        }
                    }
                }
                catch { continue; }
            }
        }

        private void ApplyWindowStyles(IntPtr hWnd, GameConfig g)
        {
            int s = GetWindowLong(hWnd, GWL_STYLE);
            if (g.IsActive)
            {
                var scr = Screen.FromHandle(hWnd);
                string monitorId = string.Empty;
                var match = _cachedMonitors.FirstOrDefault(m => CleanUnmanagedString(m.DeviceName).Equals(CleanUnmanagedString(scr.DeviceName), StringComparison.OrdinalIgnoreCase));
                if (match != null) monitorId = match.ID;
                
                if (string.IsNullOrEmpty(monitorId)) monitorId = GetPrimaryMonitorID();
                if (string.IsNullOrEmpty(monitorId)) return;

                GameDisplayProfile profile = GetEffectiveProfile(g, monitorId);
                
                uint targetStyle = (uint)(s & ~WS_CAPTION & ~WS_THICKFRAME & ~WS_MAXIMIZE);
                int targetX = scr.Bounds.X + profile.OffsetX;
                int targetY = scr.Bounds.Y + profile.OffsetY;

                GetWindowRect(hWnd, out RECT currentRect);
                bool matchesPos = (currentRect.Left == targetX && 
                                   currentRect.Top == targetY && 
                                   (currentRect.Right - currentRect.Left) == profile.Width && 
                                   (currentRect.Bottom - currentRect.Top) == profile.Height);

                if ((s & WS_CAPTION) != 0 || !matchesPos)
                {
                    ShowWindow(hWnd, SW_RESTORE);
                    SetWindowLong(hWnd, GWL_STYLE, (int)targetStyle);
                    SetWindowPos(hWnd, IntPtr.Zero, targetX, targetY, profile.Width, profile.Height, SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED);
                }
            }
            else
            {
                if ((s & WS_CAPTION) == 0)
                {
                    SetWindowLong(hWnd, GWL_STYLE, (int)(s | WS_CAPTION | WS_THICKFRAME));
                    SetWindowPos(hWnd, IntPtr.Zero, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED);
                }
            }
        }

        private void MouseClipTimer_Tick(object? sender, EventArgs e)
        {
            IntPtr hwnd = GetForegroundWindow();
            if (hwnd == IntPtr.Zero) { ClipCursor(IntPtr.Zero); return; }
            try
            {
                GetWindowThreadProcessId(hwnd, out uint pid);
                if (pid == 0) { ClipCursor(IntPtr.Zero); return; }
                using Process p = Process.GetProcessById((int)pid); string exe = (p.ProcessName + ".exe").ToLower();
                var match = _settings.Games.FirstOrDefault(g => g.IsActive && Regex.IsMatch(exe, g.RegexPattern));
                if (match != null)
                {
                    var scr = Screen.FromHandle(hwnd);
                    string monitorId = string.Empty;
                    var mMatch = _cachedMonitors.FirstOrDefault(m => CleanUnmanagedString(m.DeviceName).Equals(CleanUnmanagedString(scr.DeviceName), StringComparison.OrdinalIgnoreCase));
                    if (mMatch != null) monitorId = mMatch.ID;

                    if (string.IsNullOrEmpty(monitorId)) monitorId = GetPrimaryMonitorID();
                    if (!string.IsNullOrEmpty(monitorId))
                    {
                        GameDisplayProfile profile = GetEffectiveProfile(match, monitorId);
                        if (profile.ConstrainMouse) { if (GetWindowRect(hwnd, out RECT r)) { ClipCursor(ref r); return; } }
                    }
                }
            }
            catch { }
            ClipCursor(IntPtr.Zero);
        }
    }
}