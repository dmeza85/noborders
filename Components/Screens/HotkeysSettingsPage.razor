@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State
@implements IDisposable

<div class="nb-hotkeys-page__title">Global hotkeys</div>
<div class="nb-hotkeys-page__subline">Work while a game has focus. Click a binding, then press your combo.</div>

<div class="nb-hotkeys-page__binding @(State.IsCapturingHotkeyAdd ? "nb-hotkeys-page__binding--capturing" : "")">
    @if (State.IsCapturingHotkeyAdd)
    {
        <div class="nb-hotkeys-page__binding-info">
            <div class="nb-hotkeys-page__binding-name">Add focused app</div>
            <div class="nb-hotkeys-page__binding-sub">Listening… press a key combination. Esc to cancel.</div>
        </div>
        <div class="nb-hotkeys-page__combo">
            <div class="nb-hotkeys-page__capture-slot"></div>
        </div>
    }
    else
    {
        <div class="nb-hotkeys-page__binding-info">
            <div class="nb-hotkeys-page__binding-name nb-hotkeys-page__binding-name--resting">Add focused app</div>
            <div class="nb-hotkeys-page__status nb-hotkeys-page__status--@StatusClass(State.HotkeyAddStatusText)">
                <span class="nb-hotkeys-page__status-dot"></span>
                <span class="nb-mono">@State.HotkeyAddStatusText</span>
            </div>
        </div>
        <div class="nb-hotkeys-page__combo">
            @foreach (var (part, isLast) in WithLast(ComboParts(State.HotkeyAddApp)))
            {
                <KeyCap>@part</KeyCap>
                @if (!isLast)
                {
                    <span class="nb-hotkeys-page__plus">+</span>
                }
            }
        </div>
    }
    <button type="button" class="nb-hotkeys-page__rebind" @onclick="() => State.ToggleHotkeyAddCapture()">
        @(State.IsCapturingHotkeyAdd ? "Cancel" : "Rebind")
    </button>
</div>

<div class="nb-hotkeys-page__binding @(State.IsCapturingHotkeyRefresh ? "nb-hotkeys-page__binding--capturing" : "")">
    @if (State.IsCapturingHotkeyRefresh)
    {
        <div class="nb-hotkeys-page__binding-info">
            <div class="nb-hotkeys-page__binding-name">Re-apply / refresh displays</div>
            <div class="nb-hotkeys-page__binding-sub">Listening… press a key combination. Esc to cancel.</div>
        </div>
        <div class="nb-hotkeys-page__combo">
            <div class="nb-hotkeys-page__capture-slot"></div>
        </div>
    }
    else
    {
        <div class="nb-hotkeys-page__binding-info">
            <div class="nb-hotkeys-page__binding-name nb-hotkeys-page__binding-name--resting">Re-apply / refresh displays</div>
            <div class="nb-hotkeys-page__status nb-hotkeys-page__status--@StatusClass(State.HotkeyRefreshStatusText)">
                <span class="nb-hotkeys-page__status-dot"></span>
                <span class="nb-mono">@State.HotkeyRefreshStatusText</span>
            </div>
        </div>
        <div class="nb-hotkeys-page__combo">
            @foreach (var (part, isLast) in WithLast(ComboParts(State.HotkeyRefreshApp)))
            {
                <KeyCap>@part</KeyCap>
                @if (!isLast)
                {
                    <span class="nb-hotkeys-page__plus">+</span>
                }
            }
        </div>
    }
    <button type="button" class="nb-hotkeys-page__rebind" @onclick="() => State.ToggleHotkeyRefreshCapture()">
        @(State.IsCapturingHotkeyRefresh ? "Cancel" : "Rebind")
    </button>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    public void Dispose() => State.Changed -= OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private static string[] ComboParts(HotkeyConfig cfg) => cfg.ToString().Split(" + ");

    private static IEnumerable<(string part, bool isLast)> WithLast(string[] parts)
    {
        for (int i = 0; i < parts.Length; i++)
            yield return (parts[i], i == parts.Length - 1);
    }

    // Status text always starts with "Active" or "Not active — ..."; anything
    // else (e.g. the startup placeholder "Not yet registered") is a startup
    // transient, not a failure, so it's treated as "muted" rather than danger-red.
    private static string StatusClass(string statusText) =>
        statusText.StartsWith("Active", StringComparison.Ordinal) ? "success" :
        statusText.StartsWith("Not active", StringComparison.Ordinal) ? "danger" :
        "muted";
}
