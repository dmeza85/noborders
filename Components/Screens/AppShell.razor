@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State
@implements IDisposable

@switch (_screen)
{
    case Screen.Main:
        <MainShell ActiveTab="_mainTab" OnOpenSettings="OpenSettings" OnTabChange="SetMainTab">
            <RightPane>
                @if (_mainTab == MainShell.ShellTab.Display)
                {
                    <DisplayDetailPane />
                }
                else
                {
                    <MatchingDetailPane />
                }
            </RightPane>
        </MainShell>
        break;

    case Screen.Settings:
        <SettingsView Section="_settingsSection" OnBack="BackToMain" OnSectionChange="SetSettingsSection" OnOpenLog="OpenActivityLog" />
        break;

    case Screen.ActivityLog:
        <ActivityLogWindow OnBack="BackToSettings" />
        break;
}

@code {
    private enum Screen { Main, Settings, ActivityLog }

    private Screen _screen = Screen.Main;
    private MainShell.ShellTab _mainTab = MainShell.ShellTab.Display;
    private SettingsShell.SettingsSection _settingsSection = SettingsShell.SettingsSection.Monitors;
    private GameConfig? _lastSelectedGame;

    protected override void OnInitialized()
    {
        _lastSelectedGame = State.SelectedGame;
        State.Changed += OnStateChanged;
    }

    public void Dispose() => State.Changed -= OnStateChanged;

    private void OnStateChanged()
    {
        if (!ReferenceEquals(State.SelectedGame, _lastSelectedGame))
        {
            _lastSelectedGame = State.SelectedGame;
            _mainTab = MainShell.ShellTab.Display;
        }
        InvokeAsync(StateHasChanged);
    }

    private void OpenSettings() => _screen = Screen.Settings;
    private void OpenActivityLog() => _screen = Screen.ActivityLog;

    private void BackToMain() => _screen = Screen.Main;

    private void BackToSettings()
    {
        _settingsSection = SettingsShell.SettingsSection.Diagnostics;
        _screen = Screen.Settings;
    }

    private void SetMainTab(MainShell.ShellTab tab) => _mainTab = tab;
    private void SetSettingsSection(SettingsShell.SettingsSection section) => _settingsSection = section;
}
