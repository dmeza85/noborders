@namespace NoBorders.Components.Screens
@using NoBorders.Services
@inject AppStateService State
@implements IDisposable
@* Screen 1e — Settings: Monitors & defaults. design-handoff/README.md
   explicitly notes the RESULT PREVIEW block here is "the same component
   as 2a", so this reuses ResultPreview.razor rather than re-implementing
   it.

   Phase 3.5: wired to real data. "Connected" is MainForm._monitors
   (Screen.AllScreens, refreshed by RefreshMonitors); "Saved · not
   connected" is AppSettings.KnownMonitors minus whatever's currently
   connected. Real monitors don't carry a persisted resolution once
   unplugged (Screen.AllScreens only reports connected displays), so a
   saved-disconnected card's subline shows its saved default profile size
   (MonitorDefaults[name]) labeled "default" rather than implying it's the
   monitor's native resolution — those are two different numbers that can
   legitimately disagree.

   Phase 4.10: monitor cards are clickable — @onclick calls
   State.SelectMonitorDefaultScope, which forwards to MainForm's
   SelectMonitorDefaultScope(), which sets `_cmbSetMonitor.SelectedItem` so
   the real, unchanged `CmbSetMonitor_SelectedIndexChanged` handler runs.
   DisplayedMonitorName now prefers the real State.ActiveMonitorDefaultScope
   once it's been set, falling back to the same display-only pick (primary
   connected, else first connected, else first saved name) only before any
   card has ever been clicked. Saved cards' "✕" calls
   State.DeleteMonitorDefault, which selects that scope then triggers the
   real, unchanged BtnDeleteMonitor_Click — native confirmation MessageBoxes
   and all (not replaced with Blazor UI, same as 4.9's native file picker).
   "Save Monitor Default" calls State.SaveMonitorDefault
   (BtnSaveDefault_Click) — same "re-persists the currently-displayed value"
   scope note as 4.6/Phase 4.4: no editable stepper fields exist yet, so
   this is a real, working commit of whatever's already shown, not yet a
   way to change the numbers from Blazor. "Detect Displays"/"Remove All"
   have no backing handler anywhere in program.cs (grepped for both — no
   match), so they stay static rather than inventing new functionality. *@

<div class="nb-monitors-page">
    <div class="nb-monitors-page__title">Monitor baseline defaults</div>
    <div class="nb-monitors-page__subline">New games added on a monitor inherit these values. Existing games keep their own.</div>

    <div class="nb-monitors-page__group-header">
        <div class="nb-text-label" style="color:var(--nb-success)">CONNECTED · @State.Monitors.Count</div>
        <div class="nb-monitors-page__hairline"></div>
    </div>
    <div class="nb-monitors-page__grid">
        @foreach (var m in State.Monitors)
        {
            <MonitorCard Name="@m.ID" Detail="@ConnectedDetail(m)" Selected="@(m.ID == DisplayedMonitorName)"
                         OnSelect="() => State.SelectMonitorDefaultScope(m.ID)" />
        }
    </div>

    <div class="nb-monitors-page__group-header nb-monitors-page__group-header--saved">
        <div class="nb-text-label">SAVED · NOT CONNECTED · @SavedDisconnected.Count</div>
        <div class="nb-monitors-page__hairline"></div>
        <div class="nb-monitors-page__remove-all">Remove All</div>
    </div>
    <div class="nb-monitors-page__grid">
        @foreach (var name in SavedDisconnected)
        {
            <MonitorCard Name="@name" Detail="@SavedDetail(name)" Saved="true" Selected="@(name == DisplayedMonitorName)"
                         OnSelect="() => State.SelectMonitorDefaultScope(name)"
                         OnRemove="() => State.DeleteMonitorDefault(name)" />
        }
    </div>
    <div class="nb-monitors-page__caption">Saved monitors keep their defaults so profiles come back if the display is reconnected.</div>

    <div class="nb-monitors-page__fields">
        <div class="nb-monitors-page__field">
            <div class="nb-text-label nb-monitors-page__field-label">WIDTH</div>
            <div class="nb-monitors-page__field-value nb-mono">@DisplayedDefault.Width</div>
        </div>
        <div class="nb-monitors-page__field">
            <div class="nb-text-label nb-monitors-page__field-label">HEIGHT</div>
            <div class="nb-monitors-page__field-value nb-mono">@DisplayedDefault.Height</div>
        </div>
        <div class="nb-monitors-page__field">
            <div class="nb-text-label nb-monitors-page__field-label">OFFSET X</div>
            <div class="nb-monitors-page__field-value nb-mono">@DisplayedDefault.OffsetX</div>
        </div>
        <div class="nb-monitors-page__field">
            <div class="nb-text-label nb-monitors-page__field-label">OFFSET Y</div>
            <div class="nb-monitors-page__field-value nb-mono">@DisplayedDefault.OffsetY</div>
        </div>
    </div>

    <label class="nb-monitors-page__check">
        <span class="nb-monitors-page__check-box @(DisplayedDefault.ConstrainMouse ? "nb-monitors-page__check-box--checked" : "")"></span>
        <span>Lock cursor to window bounds by default</span>
    </label>

    <div class="nb-monitors-page__divider"></div>

    <ResultPreview MonitorWidth="PreviewMonitorWidth" MonitorHeight="PreviewMonitorHeight"
                   WindowWidth="DisplayedDefault.Width" WindowHeight="DisplayedDefault.Height"
                   OffsetX="DisplayedDefault.OffsetX" OffsetY="DisplayedDefault.OffsetY"
                   Caption="@PreviewCaption" />

    <div class="nb-monitors-page__actions">
        <button type="button" class="nb-btn nb-btn--primary" @onclick="OnSaveMonitorDefault">Save Monitor Default</button>
        <button type="button" class="nb-btn nb-btn--outline">Detect Displays</button>
    </div>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    public void Dispose() => State.Changed -= OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // Display-only fallback (same rationale as MainShell.DisplayedGame):
    // prefers the real State.ActiveMonitorDefaultScope once a card has been
    // clicked (Phase 4.10); before that, picks the primary connected
    // monitor, then the first connected, then the first saved-disconnected
    // name — purely to have something honest to show.
    private string DisplayedMonitorName =>
        !string.IsNullOrEmpty(State.ActiveMonitorDefaultScope) ? State.ActiveMonitorDefaultScope :
        (State.Monitors.FirstOrDefault(m => m.Primary) ?? State.Monitors.FirstOrDefault())?.ID
        ?? SavedDisconnected.FirstOrDefault()
        ?? string.Empty;

    private void OnSaveMonitorDefault()
    {
        if (string.IsNullOrEmpty(State.ActiveMonitorDefaultScope) && !string.IsNullOrEmpty(DisplayedMonitorName))
            State.SelectMonitorDefaultScope(DisplayedMonitorName);
        State.SaveMonitorDefault();
    }

    private MonitorItem? DisplayedConnectedMonitor =>
        State.Monitors.FirstOrDefault(m => m.ID == DisplayedMonitorName);

    // Same fallback chain as MainForm.GetEffectiveProfile() minus the
    // per-game-profile branch (there's no selected game on this page) —
    // saved default if one exists, otherwise GameDisplayProfile's own
    // schema defaults (1920×1080 @ 0,0).
    private GameDisplayProfile DisplayedDefault =>
        !string.IsNullOrEmpty(DisplayedMonitorName) && State.MonitorDefaults.TryGetValue(DisplayedMonitorName, out var def)
            ? def
            : new GameDisplayProfile();

    // The well needs the monitor's own physical resolution, which is only
    // knowable while it's connected — a saved-but-disconnected monitor has
    // no such number on file, so this falls back to the default profile's
    // own size (better than a 0×0 well).
    private int PreviewMonitorWidth  => DisplayedConnectedMonitor?.Width  ?? DisplayedDefault.Width;
    private int PreviewMonitorHeight => DisplayedConnectedMonitor?.Height ?? DisplayedDefault.Height;

    private string PreviewCaption
    {
        get
        {
            var d = DisplayedDefault;
            bool fullCoverage = d.OffsetX == 0 && d.OffsetY == 0
                && d.Width == PreviewMonitorWidth && d.Height == PreviewMonitorHeight;
            string core = $"{d.Width}×{d.Height} @ {d.OffsetX},{d.OffsetY}";
            return fullCoverage ? $"{core} — full coverage" : core;
        }
    }

    private static string ConnectedDetail(MonitorItem m) =>
        m.Primary ? $"{m.Width}×{m.Height} · primary" : $"{m.Width}×{m.Height}";

    private List<string> SavedDisconnected =>
        State.KnownMonitors
            .Where(k => !State.Monitors.Any(m => string.Equals(m.ID, k, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(k => k, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private int GameCountFor(string monitorName) =>
        State.Games.Count(g => g.Profiles.ContainsKey(monitorName));

    private string SavedDetail(string monitorName)
    {
        int games = GameCountFor(monitorName);
        string gameText = $"{games} game{(games == 1 ? "" : "s")}";
        return State.MonitorDefaults.TryGetValue(monitorName, out var def)
            ? $"{def.Width}×{def.Height} default · {gameText}"
            : gameText;
    }
}
