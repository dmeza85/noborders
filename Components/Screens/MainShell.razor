@namespace NoBorders.Components.Screens
@using NoBorders
@using NoBorders.Services
@inject AppStateService State
@implements IDisposable

<div class="nb-shell">
    <header class="nb-shell__titlebar" @onmousedown="() => State.BeginWindowDrag()">
        <div class="nb-shell__mark"></div>
        <div class="nb-text-wordmark nb-shell__wordmark">NOBORDERS</div>
        <div class="nb-text-data nb-shell__version">@AppVersion.Display</div>
        <div class="nb-shell__spacer"></div>
        <button type="button" class="nb-shell__settings-btn" @onmousedown:stopPropagation="true" @onclick="() => OnOpenSettings.InvokeAsync()">
            <span class="nb-shell__settings-ring"></span>Settings
        </button>
        <WindowControls />
    </header>

    <section class="nb-shell__hero" style="@HeroStyle">
        <div class="nb-shell__hero-scrim"></div>
        @if (string.IsNullOrEmpty(DisplayedGame?.HeroImagePath))
        {
            <div class="nb-shell__hero-caption nb-mono">hero art 16:5</div>
        }
        <div class="nb-shell__hero-content">
            <div class="nb-shell__hero-status-block">
                <div class="nb-shell__hero-status">
                    <span class="nb-shell__hero-status-dot @(IsDisplayedActive ? "" : "nb-shell__hero-status-dot--inactive")"></span>
                    <span class="nb-text-label nb-shell__hero-status-text @(IsDisplayedActive ? "" : "nb-shell__hero-status-text--inactive")">
                        @(IsDisplayedActive ? "BORDERLESS APPLIED" : "INACTIVE")
                    </span>
                </div>
                <div class="nb-text-hero nb-shell__hero-title">@(DisplayedGame?.GameName ?? "No games yet")</div>
                <div class="nb-shell__hero-meta nb-mono">@HeroMetaLine(DisplayedGame)</div>
            </div>
            <div class="nb-shell__hero-actions">
                <button type="button" class="nb-shell__hero-btn nb-shell__hero-btn--primary" disabled="@(DisplayedGame == null)" @onclick="OnTogglePrimary">
                    @(IsDisplayedActive ? "Disable Borderless" : "Enable Borderless")
                </button>
                <button type="button" class="nb-shell__hero-btn nb-shell__hero-btn--secondary @_reapplyFlash.CssClass" disabled="@(DisplayedGame == null)" @onclick="OnReapply">Re-Apply</button>
            </div>
        </div>
    </section>

    <div class="nb-shell__body">
        <aside class="nb-shell__rail">
            <div class="nb-shell__rail-filter">
                <div class="nb-shell__rail-filter-field">Filter…</div>
                <button type="button" class="nb-shell__rail-add" aria-label="Add game" @onclick="() => _showAddModal = true">＋</button>
            </div>
            <div class="nb-text-label nb-shell__rail-heading">LIBRARY · @State.Games.Count</div>
            @foreach (var g in State.Games)
            {
                var selected = g == DisplayedGame;
                var tier = RowTier(g, selected);
                <div @key="g" class="nb-shell__rail-row @(selected ? "nb-shell__rail-row--selected" : "")" @onclick="() => State.SelectGame(g)">
                    <div class="nb-shell__rail-thumb @(selected ? "nb-shell__rail-thumb--selected" : "")" style="@ThumbStyle(g)"></div>
                    <div class="nb-shell__rail-info">
                        <div class="nb-shell__rail-name nb-shell__rail-name--@tier">@g.GameName</div>
                    </div>
                    @if (g.IsActive)
                    {
                        <div class="nb-shell__rail-on nb-mono">ON</div>
                    }
                </div>
            }
        </aside>

        <div class="nb-shell__right">
            <div class="nb-shell__tabs">
                <div class="nb-shell__tab @(ActiveTab == ShellTab.Display ? "nb-shell__tab--active" : "")" @onclick="() => OnTabChange.InvokeAsync(ShellTab.Display)">Display</div>
                <div class="nb-shell__tab @(ActiveTab == ShellTab.Matching ? "nb-shell__tab--active" : "")" @onclick="() => OnTabChange.InvokeAsync(ShellTab.Matching)">Matching</div>
            </div>
            @RightPane
        </div>
    </div>

    <footer class="nb-shell__statusbar nb-text-statusbar">
        @if (!string.IsNullOrEmpty(AddHotkeyHint))
        {
            <span>@AddHotkeyHint add</span>
        }
        @if (!string.IsNullOrEmpty(RefreshHotkeyHint))
        {
            <span>@RefreshHotkeyHint refresh</span>
        }
        <div class="nb-shell__statusbar-spacer"></div>
        @if (State.ToastVisible)
        {
            <div class="nb-shell__statusbar-toast">
                <StatusBarToast Title="@State.ToastTitle" Detail="@State.ToastDetail" Level="State.ToastLevel" IconUrl="@State.ToastIconPath" />
            </div>
        }
        <span class="nb-shell__usertype" role="button" tabindex="0"
              title="@(State.IsElevated ? "Restart without Administrator rights" : "Restart as Administrator")"
              @onclick="OnUserTypeClick">@(State.IsElevated ? "administrator" : "standard user")</span>
    </footer>

    @if (_showAddModal)
    {
        <AddRunningAppModal OnClose="() => _showAddModal = false" />
    }
</div>

@code {
    private readonly FlashFeedback _reapplyFlash;
    public MainShell() => _reapplyFlash = new FlashFeedback(StateHasChanged);

    public enum ShellTab { Display, Matching }

    [Parameter] public ShellTab ActiveTab { get; set; } = ShellTab.Display;
    [Parameter] public RenderFragment? RightPane { get; set; }

    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public EventCallback<ShellTab> OnTabChange { get; set; }

    private bool _showAddModal;

    private void OnUserTypeClick()
    {
        if (State.IsElevated)
            State.ConfirmAndRestartAsStandardUser();
        else
            State.ConfirmAndRestartAsAdmin();
    }

    protected override void OnInitialized() => State.Changed += OnStateChanged;
    public void Dispose() => State.Changed -= OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private string? AddHotkeyHint => HintOrNull(State.HotkeyAddApp);
    private string? RefreshHotkeyHint => HintOrNull(State.HotkeyRefreshApp);

    private static string? HintOrNull(HotkeyConfig cfg)
    {
        string text = cfg.ToString();
        return text == "None" ? null : text;
    }

    private GameConfig? DisplayedGame => State.SelectedGame ?? State.Games.FirstOrDefault();

    private bool IsDisplayedActive => DisplayedGame?.IsActive == true;

    private string HeroStyle =>
        string.IsNullOrEmpty(DisplayedGame?.HeroImagePath) ? "" : $"background-image:url('{ArtworkService.CssUrlEscape(DisplayedGame.HeroImagePath)}');background-size:cover;background-position:center;";

    private static string ThumbStyle(GameConfig g) =>
        string.IsNullOrEmpty(g.IconImagePath) ? "" : $"background-image:url('{ArtworkService.CssUrlEscape(g.IconImagePath)}');background-size:cover;background-position:center;";

    private void OnTogglePrimary()
    {
        if (State.SelectedGame == null && DisplayedGame != null)
            State.SelectGame(DisplayedGame);
        State.ToggleActive();
    }

    private async Task OnReapply()
    {
        if (State.SelectedGame == null && DisplayedGame != null)
            State.SelectGame(DisplayedGame);
        State.ReapplyBorderless();
        await _reapplyFlash.Trigger();
    }

    private string ActiveMonitorName =>
        !string.IsNullOrEmpty(State.ActiveMonitorScope) ? State.ActiveMonitorScope :
        DisplayedGame?.Profiles.Keys.FirstOrDefault()
        ?? (State.Monitors.FirstOrDefault(m => m.Primary) ?? State.Monitors.FirstOrDefault())?.ID
        ?? State.KnownMonitors.FirstOrDefault()
        ?? string.Empty;

    private string HeroMetaLine(GameConfig? g)
    {
        if (g == null) return string.Empty;
        string monitor = ActiveMonitorName;
        if (string.IsNullOrEmpty(monitor)) return "no display profile saved yet";
        string offsetX = State.OffsetX >= 0 ? $"+{State.OffsetX}" : State.OffsetX.ToString();
        string offsetY = State.OffsetY >= 0 ? $"+{State.OffsetY}" : State.OffsetY.ToString();
        string cursor = State.ConstrainMouse ? "cursor locked" : "cursor free";
        return $"{State.Width}×{State.Height} · {offsetX},{offsetY} · {monitor} · {cursor}";
    }

    private static string RowTier(GameConfig g, bool selected) =>
        selected ? "selected" : g.IsActive ? "active" : "inactive";
}
