<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>NoBorders</AssemblyName>
    <RootNamespace>NoBorders</RootNamespace>

    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- Nothing in this project opts into ahead-of-time compilation, so every
         method — Blazor's RenderTreeBuilder/diffing, WinForms event plumbing,
         the first-ever call into any Razor component's @code block — sits
         entirely on the runtime JIT. Tiered JIT means those first calls run
         through the slow, unoptimized Tier0 compile, and it's a one-time cost
         per method: whichever code path a user's first click happens to hit
         (e.g. opening AddRunningAppModal) pays it live, right after launch,
         then is fast on every later run of the same path. ReadyToRun
         precompiles the app's own IL (and matching framework assemblies) at
         publish time, so that first hit is already native code instead of a
         cold JIT compile — this is what actually fixes the reported
         300-500ms first-interaction delay, not just a build-output tweak.
         Only takes effect on `dotnet publish` (needs SelfContained +
         RuntimeIdentifier, both already set above); has no effect on
         `dotnet build`/F5 debugging. -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- "Borderless Gaming App UI/icon_export" source assets (README.md
         there) — packed into app.ico via wwwroot/img/MainForm.Tray.cs. This
         is what sets the taskbar/title-bar/Alt-Tab icon; TryExtractIcon
         (program.cs) reads it back via Icon.ExtractAssociatedIcon. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.90" />
    <!-- Already a transitive dependency of the package above — made direct,
         with GeneratePathProperty, purely so $(PkgMicrosoft_AspNetCore_Components_WebView)
         below can reliably locate its bundled blazor.webview.js/blazor.modules.json
         (see the EmbeddedResource ItemGroup after RemoveWebView2WpfReference)
         without hardcoding a version-specific NuGet cache path. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.0" GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    review.md §5: NoBorders.Tests sits in a subdirectory of this project's own
    directory, so the SDK's default recursive globbing (**/*.cs, **/wwwroot/**
    etc.) would otherwise also pull its files — and its xunit references —
    into this project. Exclude that whole subtree explicitly. Same reasoning
    for "Borderless Gaming App UI" — the icon set's source SVGs/PNGs/README,
    kept for reference but not meant to be compiled/published as-is (the
    pieces actually used were copied into wwwroot/img, Resources/, and
    app.ico).
  -->
  <ItemGroup>
    <Compile Remove="NoBorders.Tests\**\*.cs" />
    <Content Remove="NoBorders.Tests\**" />
    <None Remove="NoBorders.Tests\**" />
    <Content Remove="Borderless Gaming App UI\**" />
    <None Remove="Borderless Gaming App UI\**" />
  </ItemGroup>

  <!-- Tray icon's theme-adaptive mono variants (MainForm.Tray.cs) — embedded
       so they travel inside the self-contained single-file publish output
       rather than needing loose files beside the exe. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\tray-16-dark.png" />
    <EmbeddedResource Include="Resources\tray-16-light.png" />
  </ItemGroup>

  <!--
    Portable single-exe support: PublishSingleFile bundles the .NET runtime
    and managed code into one exe, but never wwwroot — confirmed live by
    copying just NoBorders.exe to an empty folder and getting a blank
    BlazorWebView window, no content at all. wwwroot is embedded here too
    (LogicalName preserves the real relative path with forward slashes, so
    EmbeddedWwwroot.Extract() in program.cs can recover it with a plain
    prefix strip instead of guessing at EmbeddedFileProvider's own dot-
    joined naming convention, which is ambiguous for filenames with more
    than one dot). Extracted to disk on first run; ArtworkAwareBlazorWebView.
    CreateFileProvider still serves everything through a normal
    PhysicalFileProvider, same as it always has — only where that physical
    folder lives is new.

    Two more files index.html needs that a source-tree glob can't reach,
    since neither exists until build time: NoBorders.styles.css (the Razor
    SDK's CSS-isolation bundle of every *.razor.css — confirmed live at
    $(IntermediateOutputPath)scopedcss\bundle\) and _framework/
    blazor.webview.js + blazor.modules.json, which ship inside the
    Microsoft.AspNetCore.Components.WebView package's own staticwebassets
    folder, not this project's output (confirmed live via
    $(PkgMicrosoft_AspNetCore_Components_WebView), from the direct
    PackageReference above). Missing either one leaves the app stuck on
    index.html's "Loading NoBorders…" placeholder forever — confirmed live,
    the same way the missing wwwroot folder itself was confirmed above.

    NoBorders.styles.css specifically needs its own Target, not a plain
    ItemGroup: confirmed live on a genuine clean build (no cached obj\) that
    it goes missing from the embedded set otherwise — BundleScopedCssFiles
    (Microsoft.NET.Sdk.StaticWebAssets) hadn't generated the file yet at the
    point a top-level ItemGroup's Condition="Exists(...)" gets evaluated, so
    it silently evaluated false and skipped the embed. AfterTargets here
    guarantees the file already exists; BeforeTargets guarantees it's still
    embedded in time for compilation to pick it up.
  -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" LogicalName="EmbeddedWwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgMicrosoft_AspNetCore_Components_WebView)\staticwebassets\blazor.webview.js"
                      LogicalName="EmbeddedWwwroot/_framework/blazor.webview.js" />
    <EmbeddedResource Include="$(PkgMicrosoft_AspNetCore_Components_WebView)\staticwebassets\blazor.modules.json"
                      LogicalName="EmbeddedWwwroot/_framework/blazor.modules.json" />
  </ItemGroup>

  <Target Name="EmbedScopedCssBundle" DependsOnTargets="BundleScopedCssFiles" BeforeTargets="AssignTargetPaths;CoreCompile">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)scopedcss\bundle\$(TargetName).styles.css"
                        LogicalName="EmbeddedWwwroot/$(TargetName).styles.css"
                        Condition="Exists('$(IntermediateOutputPath)scopedcss\bundle\$(TargetName).styles.css')" />
    </ItemGroup>
  </Target>

  <!-- The publish output otherwise also includes NoBorders.pdb (debug
       symbols) and WebView2's own bundled XML doc comments — neither is
       useful to an end user and both are extra files sitting next to what's
       supposed to be a single portable exe. -->
  <PropertyGroup>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <Target Name="RemovePackageXmlDocs" AfterTargets="Publish">
    <ItemGroup>
      <_StrayPublishFiles Include="$(PublishDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(_StrayPublishFiles)" />
  </Target>

  <!--
    review.md §4.6: Microsoft.Web.WebView2 (pulled in transitively by the
    WindowsForms WebView package above) ships lib DLLs for every UI framework
    it supports — Core, WinForms, AND Wpf — and its buildTransitive targets
    reference all of them unconditionally, regardless of which one a
    consuming project actually uses. This app is WinForms-only (UseWpf is
    never set), so Microsoft.Web.WebView2.Wpf.dll is a dead reference here —
    but it still drags in WPF's WindowsBase 5.0.0.0, conflicting with the
    WindowsBase 4.0.0.0 the WinForms target itself references (MSB3277 on
    every build). Removing the WPF reference after it's resolved is the
    standard workaround for this well-documented WebView2 packaging quirk
    (see MicrosoftEdge/WebView2Feedback#1355) — deliberate, not a suppression
    of a real problem, since the WPF assembly is never loaded at runtime.
  -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>