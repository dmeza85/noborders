@namespace NoBorders.Components.Screens
@* Screen 1g's elevation prompt, design-handoff/README.md §"1g — Elevation
   prompt · tray menu · toast". Only the dialog and toast are built here
   per Phase 2.9's scope — the tray context menu stays the native
   ContextMenuStrip (out of scope, not rebuilt in Razor). Static —
   Not Now/Restart As Admin don't do anything yet; this corresponds to
   PromptRestartAsAdmin in program.cs. *@

<ModalOverlay Width="470" BorderColor="#33291a" Background="var(--nb-surface)">
    <div class="nb-elevation">
        <div class="nb-elevation__header">
            <div class="nb-elevation__icon">!</div>
            <div class="nb-elevation__title">Administrator rights needed</div>
        </div>
        <div class="nb-elevation__body">
            NoBorders added <span class="nb-elevation__game">@GameName</span> but couldn't strip its window border. The game runs elevated — usually anti-cheat — and Windows blocks a standard-user app from touching it.
        </div>
        <div class="nb-elevation__detail nb-mono">
            <div>@ErrorLine</div>
            <div>@TargetLine</div>
        </div>
        <div class="nb-elevation__actions">
            <div class="nb-elevation__spacer"></div>
            <button type="button" class="nb-btn nb-btn--outline nb-btn--compact">Not Now</button>
            <button type="button" class="nb-btn nb-btn--warning">Restart As Admin</button>
        </div>
    </div>
</ModalOverlay>

@code {
    [Parameter] public string GameName { get; set; } = "Valorant";
    [Parameter] public string ErrorLine { get; set; } = "SetWindowLong → ERROR_ACCESS_DENIED (5)";
    [Parameter] public string TargetLine { get; set; } = "target: vgc-protected process";
}
