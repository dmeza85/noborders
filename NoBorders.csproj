<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>NoBorders</AssemblyName>
    <RootNamespace>NoBorders</RootNamespace>

    <Version>1.2.5</Version>
    <AssemblyVersion>1.2.5.0</AssemblyVersion>
    <FileVersion>1.2.5.0</FileVersion>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <PublishReadyToRun>true</PublishReadyToRun>

    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.90" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.0" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Excludes subprojects/asset folders the SDK's default recursive globbing would otherwise pull in. -->
  <ItemGroup>
    <Compile Remove="NoBorders.Tests\**\*.cs" />
    <Content Remove="NoBorders.Tests\**" />
    <None Remove="NoBorders.Tests\**" />
    <Content Remove="Borderless Gaming App UI\**" />
    <None Remove="Borderless Gaming App UI\**" />
    <Compile Remove="ThrashTestHarness\**\*.cs" />
    <Content Remove="ThrashTestHarness\**" />
    <None Remove="ThrashTestHarness\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\tray-16-dark.png" />
    <EmbeddedResource Include="Resources\tray-16-light.png" />
  </ItemGroup>

  <!-- wwwroot and WebView's own static assets are embedded (not just published) so a self-contained
       single-file exe serves its own content with no loose files; extracted to disk on first run by
       EmbeddedWwwroot.Extract() in program.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" LogicalName="EmbeddedWwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgMicrosoft_AspNetCore_Components_WebView)\staticwebassets\blazor.webview.js"
                      LogicalName="EmbeddedWwwroot/_framework/blazor.webview.js" />
    <EmbeddedResource Include="$(PkgMicrosoft_AspNetCore_Components_WebView)\staticwebassets\blazor.modules.json"
                      LogicalName="EmbeddedWwwroot/_framework/blazor.modules.json" />
  </ItemGroup>

  <!-- Must run after BundleScopedCssFiles generates the .styles.css and before CoreCompile embeds it,
       or the file doesn't exist yet when a plain ItemGroup would have evaluated its Condition. -->
  <Target Name="EmbedScopedCssBundle" DependsOnTargets="BundleScopedCssFiles" BeforeTargets="AssignTargetPaths;CoreCompile">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)scopedcss\bundle\$(TargetName).styles.css"
                        LogicalName="EmbeddedWwwroot/$(TargetName).styles.css"
                        Condition="Exists('$(IntermediateOutputPath)scopedcss\bundle\$(TargetName).styles.css')" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <Target Name="RemovePackageXmlDocs" AfterTargets="Publish">
    <ItemGroup>
      <_StrayPublishFiles Include="$(PublishDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(_StrayPublishFiles)" />
  </Target>

  <!-- A plain `dotnet build` drops a staticwebassets.runtime.json next to the exe that hardcodes this
       machine's absolute NuGet/source paths; BlazorWebView's StaticWebAssetsLoader builds a
       PhysicalFileProvider from it at startup and throws if those paths don't exist elsewhere. This app
       serves wwwroot from embedded resources instead, so the manifest is unused — delete it. (Disabling
       StaticWebAssetsEnabled instead also breaks BundleScopedCssFiles/EmbedScopedCssBundle above.) -->
  <Target Name="RemoveStaticWebAssetsRuntimeManifest" AfterTargets="Build">
    <ItemGroup>
      <_StaleStaticWebAssetsManifest Include="$(OutDir)$(TargetName).staticwebassets.runtime.json" />
    </ItemGroup>
    <Delete Files="@(_StaleStaticWebAssetsManifest)" Condition="Exists('$(OutDir)$(TargetName).staticwebassets.runtime.json')" />
  </Target>

  <!-- WebView2's buildTransitive targets reference its Wpf DLL unconditionally even on a WinForms-only
       project, which drags in a conflicting WindowsBase version (MSB3277). Known packaging quirk
       (MicrosoftEdge/WebView2Feedback#1355); the Wpf assembly is never loaded at runtime. -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>